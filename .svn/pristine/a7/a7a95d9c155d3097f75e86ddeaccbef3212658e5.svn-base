/* user_center/pages/shaohuo/shaohuo.wxss */
.main {
	height: 760rpx;
	border:1px solid #bbbbbb;
	margin: 0 20rpx;
	border-radius: 20rpx;
}
.belongings {
	height: 100rpx;
	border-bottom: 1px solid #bbbbbb;
	display: flex;
}
.item_l {
	width: 24%;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #101010;
}
.item_r {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #BBBBBB;
	font-size: 14px;
}
.pic {
	height: 295rpx;
	border-bottom: 1px solid #bbbbbb;
	padding: 0 20rpx;
}
.pic .txt {
	font-size: 12px;
	color: #F08718;
}
.pic .uplode {
	height: 100rpx;
	width: 150rpx;
	border: 1px solid #bbbbbb;
	font-size: 24rpx;
	color: #bbbbbb;
	line-height: 100rpx;
	text-align: center;
	display: flex;
	align-items: center;
	justify-content: center;
	display: inline-block;
	float: left;
}
.pic .uplode image {
	width: 24rpx;
	height: 24rpx;
	margin-right: 10rpx;
}
.phcolor {
	text-align: center;
	width: 100%;
	display: flex;
	flex-direction: column;
}
.placeholder {
	color: #BBBBBB;
}
.pic .imgs {
	height: 100rpx;
	float: left;
	margin-left: 10rpx;
}
.pic .imgs image {
	width: 100rpx;
	height: 100rpx;
}
.boxs {
	height: 130rpx;
	border-bottom: 1px solid #bbbbbb;
}
.boxs .sendMail {
	height: 60rpx;
	display: flex;
}
.boxs .pickUp {
	height: 60rpx;
	display: flex;
}
.items_l {
	width: 30%;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #101010;
}
.items_r {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #BBBBBB;
	font-size: 14px;
}
.remarks {
	height: 100rpx;
	display: flex;
}
.xing_txt {
	height: 80rpx;
	line-height: 80rpx;
	color: #F08718;
	padding-left: 20rpx;
	font-weight: 700;
}
/* -------------------- */
.preview-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  z-index: 999;
  display: flex;
  justify-content: center;
  align-items: center;
}

.preview-img {
  height: 80vh;
  max-width: 100%;
  object-fit: contain;
}

.delete-btn {
  position: absolute;
  bottom: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  background-color: #ff4d4f;
  color: white;
  border-radius: 50rpx;
}
.method {
  width: 100%;
  height: 150rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
}
.method_l {
  
}
.method_r {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #101010 !important;
}