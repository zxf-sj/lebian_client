<view id="slide-coupon" class="slide-coupon" wx:if="{{showCoupon}}" bind:tap="handleBox">
  <view class="inner" >
    <view class="title">
      <text class="coupon {{types =='优惠卷'? 'choice':''}}"  catchtap="clickyouhui">选择优惠券</text>
      <text class="session {{types =='次卡'? 'choice':''}}"  catchtap="clickcika">选择次卡</text>
      <!-- <view class="del" bindtap="close" wx:if="{{types == '优惠卷'}}">
        <image class="del-img" src="/assets/images/close.png" ></image>
      </view> -->
      <!-- wx:else -->
      <button class="mini-btn submitBtn" catchtap="handleSubmit" type="primary" size="mini" >确定</button>
    </view>
    <scroll-view wx:if="{{hasCoupon}}" class="scroll-box" scroll-y="true" bindscrolltolower="scrollToLower">
      <!-- <view class="item" wx:for="{{juan}}" wx:key="index" wx:if="{{types == '优惠卷'}}">
        <view class="top">
          <block wx:if="{{fromIcon}}">
              <view class="l">
                <image src="/assets/images/canUseCa.png" style="width:80rpx;height:80rpx;"></image>
                <view class="item-name">
                  <view>{{item.CouponType_Name}}</view>
                  <view wx:if="{{item.CouponType == '100004-0001030002'}}" class="item-num">抵扣：{{item.CouponMoney}}元</view>
                </view>
              </view>
              
              <view class="r" bindtap="exchange" data-item="{{item}}" wx:if="{{item.CouponType == '100004-0001030002'}}">使用</view>
              <label class="radio" wx:else>
              <radio  checked="{{item.selected}}" bind:tap="handleRadio" data-item="{{index}}" />
            </label>
         
          </block>
        </view>
        <view class="btm" wx:if="{{item.IsForever=='100004-0000010001'}}">长期有效</view>
        <view class="btm" wx:if="{{item.IsForever=='100004-0000010002'}}">有效时间：{{item.EndTime}}</view>
      </view> -->
      <view class="item" wx:for="{{types == '次卡'?ka:juan}}" wx:key="index" >
        <view class="top">
          <block wx:if="{{fromIcon}}">
              <view class="l">
                <image src="/assets/images/canUseCa.png" style="width:80rpx;height:80rpx;"></image>
                <view class="item-name">
                  <view>{{item.CouponType_Name}}</view>
                  <view wx:if="{{item.CouponType == '100004-0001030002'}}" class="item-num">抵扣：{{item.CouponMoney}}元</view>
                </view>
              </view>
              
              <!-- <view class="r" bindtap="exchange" data-item="{{item}}" wx:if="{{item.CouponType == '100004-0001030002'}}">使用</view> -->
              <!-- wx:else -->
              <label class="radio" >
              <radio  checked="{{item.selected}}" catchtap="handleRadio" data-item="{{index}}" />
            </label>
            <!-- </view> -->
          </block>
        </view>
        <view class="btm" wx:if="{{item.IsForever=='100004-0000010001'}}">长期有效</view>
        <view class="btm" wx:if="{{item.IsForever=='100004-0000010002'}}">有效时间：{{item.EndTime}}</view>
      </view>
    </scroll-view>
    <view class="no-coupon" wx:elif="{{!hasCoupon && !fromIcon}}">
      <image src="/assets/images/no-coupon.png" style="width:296rpx;height:200rpx;margin-bottom:20rpx;"></image>
      <view>暂时没有优惠券</view>
    </view>
  </view>
</view>