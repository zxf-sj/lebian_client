// user_center/pages/reserve/reserve.js
const BASE_URL = require("../../../utils/BASE_URL");
var baseUrl = BASE_URL.BASE_URL //配置基础url
Page({

  /**
   * 页面的初始数据
   */
  data: {
    switchDate:0,
    handleItem:null,
    typeon:'',//拼车、包车
    lineld:'',//路线ID
    startingCity:'',//出发城市
    endingCity:'',//到达城市
    startDate:"",//出行日期
    priceList:'',
    today:'',
    seatList:[],
    day1:'',
    day2:'',
    day3:'',
    day4:'',
    week:'',
    propsDay:'',
    propsTxt:'',
  },

  /**
   * 生命周期函数--监听页面加载
   */
  onLoad(options) {
    let _this = this;
    let storedData = wx.getStorageSync('storageSync') || {};
    let updatedData = { ...storedData, startDate: _this.getFutureDate2(0) };
    wx.setStorageSync('storageSync', updatedData);
    this.setData({
      day1:_this.getFutureDate(0),
      day2:_this.getFutureDate(1),
      day3:_this.getFutureDate(2),
      day4:_this.getFutureDate(3),
      week:_this.getDayAfterTomorrow()
    })
    if(options) {
      _this.setData({
        lineld:options.lineld,
        endingCity:options.endingCity,
        startDate:options.startDate,
        startingCity:options.startingCity,
        typeon:options.typeon
      })
      if(_this.getFutureDate2(0) == options.startDate) {
        this.setData({
          switchDate:0
        })
      } else if(_this.getFutureDate2(1) == options.startDate) {
        this.setData({
          switchDate:1
        })
      }else if(_this.getFutureDate2(2) == options.startDate) {
        this.setData({
          switchDate:2
        })
      }else if(_this.getFutureDate2(3) == options.startDate) {
        this.setData({
          switchDate:3
        })
      }
      if(this.data.switchDate == 0) {
        let storedData = wx.getStorageSync('pcTimeSync') || {};
        let updatedData = { ...storedData, propsDay: this.data.day1,propsTxt:'今天'};
        wx.setStorageSync('pcTimeSync', updatedData);
        this.setData({
          propsDay:this.data.day1,
          propsTxt:'今天'
        })
      } else if(this.data.switchDate == 1) {
        let storedData = wx.getStorageSync('pcTimeSync') || {};
        let updatedData = { ...storedData, propsDay: this.data.day2,propsTxt:'明天'};
        wx.setStorageSync('pcTimeSync', updatedData);
        this.setData({
          propsDay: this.data.day2,
          propsTxt:'明天'
        })
      }else if(this.data.switchDate == 2) {
        let storedData = wx.getStorageSync('pcTimeSync') || {};
        let updatedData = { ...storedData, propsDay: this.data.day3,propsTxt:'后天'};
        wx.setStorageSync('pcTimeSync', updatedData);
        this.setData({
          propsDay: this.data.day3,
          propsTxt:'后天'
        })
      }else if(this.data.switchDate == 3) {
        let storedData = wx.getStorageSync('pcTimeSync') || {};
        let updatedData = { ...storedData, propsDay: this.data.day4,propsTxt:this.data.week};
        wx.setStorageSync('pcTimeSync', updatedData);
        this.setData({
          propsDay: this.data.day4,
          propsTxt:this.data.week
        })
      }
      _this.getList()
    }
  },

  /**
   * 生命周期函数--监听页面初次渲染完成
   */
  onReady() {

  },

  /**
   * 生命周期函数--监听页面显示
   */
  onShow() {
    
  },
  //获取四天日期
  getFutureDate(days) {
    let futureDate = new Date();
    futureDate.setDate(futureDate.getDate() + days);
    return futureDate.toISOString().slice(5, 7) + '/' + futureDate.toISOString().slice(8, 10);
  },
  getFutureDate2(days) {
    let futureDate = new Date();
    futureDate.setDate(futureDate.getDate() + days);
    return futureDate.toISOString().slice(0, 10);
  },
  //获取大后天是周几
  getDayAfterTomorrow() {
    var today = new Date();
    today.setDate(today.getDate() + 3);
    var dayOfWeek = today.getDay();
    var days = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
    return days[dayOfWeek];
},
 
  //请求列表
   getList() {
    wx.showLoading({
      title: '加载中',
    })
    
    
    return new Promise((resolve) => {
      wx.request({
        url:baseUrl + '/api/DispatchMobile/GetLineEmptySeatNumAndPrice',
        data:{
          lineId:this.data.lineld,
          today:this.data.startDate,
          IsExclusive:'100004-0000010002',
        },
        method:"GET",
        success:(res)=>{
          wx.hideLoading()
          if(res.data.code == 0) {
            let data = res.data.data
            this.setData({
              priceList:data.PriceList[0],
              today:data.SeatData[0].Today,
              seatList:data.SeatData[0].SeatList
            })
            wx.setStorageSync('pcTypeId', data.PriceList[0].Id);
          } else {
            wx.showToast({
              title: res.data.msg,
              icon:"error"
            })
          }
          resolve(res)
        },
        fail(res) {
          console.log(res)
          wx.hideLoading()
        },
        complete(res) {
          wx.hideLoading()
        }
      })
    })
  },
  //切换日期
  async switchDate(e) {
    let dateString = e.currentTarget.dataset.tody;
    let year = new Date().getFullYear();
    let formattedDate = this.formatDate(dateString,year)
    this.setData({
      startDate:formattedDate,
      propsDay:e.currentTarget.dataset.tody,
      propsTxt:e.currentTarget.dataset.txt
    })
    let storedData = wx.getStorageSync('storageSync') || {};
    let updatedData = { ...storedData, startDate: formattedDate };
    wx.setStorageSync('storageSync', updatedData);
    
    await  this.getList();
    this.setData({
      switchDate:e.currentTarget.dataset.item,
    })
  },
  formatDate(monthDay, year) {
    const [month, day] = monthDay.split('/');
    const date = new Date(year, month - 1, day); // 月份是从0开始的，所以需要减1
    const formattedDate = date.toLocaleDateString('en-CA').replace(/\//g, '-'); // 使用加拿大格式并替换斜杠为短横线
    return formattedDate;
},
  handleItem(e) {
    this.setData({
      handleItem:e.currentTarget.dataset.item
    })
    let data = e.currentTarget.dataset.itemdata
    let storedData = wx.getStorageSync('pcTimeSync') || {};
    let updatedData = { ...storedData, propsDay: this.data.propsDay, propsTxt:this.data.propsTxt,EndTime:data.EndTime,StartTime:data.StartTime,Price:this.data.priceList.Price};
    wx.setStorageSync('pcTimeSync', updatedData);

    wx.navigateTo({
      url: '/pages/pingche2/pingche2',
    })
  },
  /**
   * 生命周期函数--监听页面隐藏
   */
  onHide() {

  },

  /**
   * 生命周期函数--监听页面卸载
   */
  onUnload() {
    
  },

  /**
   * 页面相关事件处理函数--监听用户下拉动作
   */
  onPullDownRefresh() {

  },

  /**
   * 页面上拉触底事件的处理函数
   */
  onReachBottom() {

  },

  /**
   * 用户点击右上角分享
   */
  onShareAppMessage() {

  }
})