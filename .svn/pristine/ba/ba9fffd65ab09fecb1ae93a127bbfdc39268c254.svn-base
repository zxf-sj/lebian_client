/* user_center/pages/invoice/invoice.wxss */

/* pages/form/form.wxss */
.container {
    padding: 20rpx;
    background-color: #f8f8f8;
    font-size: 28rpx;
  }
  
  .section {
    background: #fff;
    margin-bottom: 40rpx;
    border-radius: 16rpx;
    padding: 30rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  }
  
  .title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    display: block;
    margin-bottom: 30rpx;
  }
  
  .input-item {
    display: flex;
    align-items: center;
    margin-bottom: 25rpx;
    border-bottom: 1rpx solid #eee;
    padding: 20rpx 0;
  }
  
  .input-item:last-child {
    margin-bottom: 0;
  }
  
  .label {
    width: 180rpx;
    font-size: 28rpx;
    color: #333;
  }
  
  input, textarea {
    flex: 1;
    height: 60rpx;
    line-height: 60rpx;
    font-size: 28rpx;
    color: #555;
  }
  
  textarea {
    height: 120rpx;
    padding: 20rpx 0;
  }
  
  .picker-view {
    flex: 1;
    height: 60rpx;
    line-height: 60rpx;
    color: #555;
  }
  
  .textarea-item {
    align-items: flex-start;
  }
  
  .submit-btn {
    background-color: #07c160;
    color: white;
    margin-top: 40rpx;
    font-size: 30rpx;
  }
  
  .reset-btn {
    background-color: #aaa;
    color: white;
    margin-top: 20rpx;
    font-size: 30rpx;
  }
  .xingxing {
      color: #ff0000;
  }
  .nav {
      width: 100%;
      height: 100rpx;
  }
  .computes {
      width: 200rpx;
      height: 60rpx;
      background-color: #07c160;
      color: #fff;
      line-height: 60rpx;
      text-align: center;
      margin: 0 auto;
      border-radius: 10rpx;
  }
  .edit {
      width: 60rpx;
      height: 60rpx;
  }
  .edit image {
    width: 50rpx;
    height: 50rpx;
  }
  .pop_up {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: rgba(0, 0, 0,.7);
    z-index: 9999;
    overflow: hidden;
  }
  @keyframes slide-up{
    from{
      bottom: -650rpx;
    }
    to{
      bottom: 0;
    }
  }
  
  .pop_box{
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 650rpx;
    /* background: linear-gradient(180deg, rgb(255, 255, 255) 0%,rgba(240,135,24,1) 100%); */
    background-color: #fff;
    box-sizing: border-box;
    padding: 20rpx;
    color: #333;
    animation: slide-up .5s;
  }
  .scroll-box{
    width: 100%;
    height: 362rpx;
  }
  .nav_icon {
      width: 100%;
      height: 140rpx;
      border-bottom: 1px solid #e3e3e3;
      display: flex;
      color: #020202;
  }
  .nav_icon2 {
    width: 100%;
    height: 100rpx;
    border-bottom: 1px solid #e3e3e3;
    display: flex;
  }
  .nav_icon .item_l {
    height: 140rpx;
    flex: 1;
  }
  .nav_icon .item_l .pop_title {
    width: 100%;
    height: 60rpx;
    line-height: 60rpx;
    margin-top: 20rpx;
  }
  .nav_icon .item_l .pop_num {
    width: 100%;
    height: 60rpx;
    line-height: 60rpx;
}
  .nav_icon .item_r {
      width: 140rpx;
      height: 140rpx;
      font-size: 40rpx;
      line-height: 140rpx;
      text-align: center;
      color: #f07c41;
}
  .xxx {
      width: 140rpx;
      height: 100rpx;
      font-size: 40rpx;
      color: #323232;
      font-weight: 700;
      line-height: 100rpx;
  }
  .pop_bottom {
      width: 100%;
      height: 100rpx;
      position: absolute;
      box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
        z-index: 999;
        align-self: start;
        margin-bottom: env(safe-area-inset-bottom);
        background-color: #4a4c5b;
        color: #fff;
        font-size: 28rpx;
      bottom: 0;
      left: 0;
      line-height: 100rpx;
      text-align: center;
  }