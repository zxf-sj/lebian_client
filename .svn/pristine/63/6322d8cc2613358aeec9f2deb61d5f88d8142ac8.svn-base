/* user_center/pages/shaohuo/shaohuo.wxss */
.main {
	height: 710rpx;
	border:1px solid #bbbbbb;
	margin: 0 20rpx;
	border-radius: 20rpx;
}
.belongings {
	height: 100rpx;
	border-bottom: 1px solid #bbbbbb;
	display: flex;
}
.item_l {
	width: 24%;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #101010;
}
.item_r {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #BBBBBB;
	font-size: 14px;
}
.pic {
	height: 380rpx;
	border-bottom: 1px solid #bbbbbb;
	padding: 0 20rpx;
}
.pic .txt {
	font-size: 12px;
	color: #F08718;
}
.pic .uplode {
	height: 100rpx;
	width: 150rpx;
	border: 1px solid #bbbbbb;
	font-size: 24rpx;
	color: #bbbbbb;
	line-height: 100rpx;
	text-align: center;
	display: flex;
	align-items: center;
	justify-content: center;
	display: inline-block;
	float: left;
}
.pic .uplode image {
	width: 24rpx;
	height: 24rpx;
	margin-right: 10rpx;
}
.phcolor {
	text-align: center;
	width: 100%;
	display: flex;
	flex-direction: column;
}
.placeholder {
	color: #BBBBBB;
}
.pic .imgs {
	height: 100rpx;
	float: left;
	margin-left: 10rpx;
}
.pic .imgs image {
	width: 100rpx;
	height: 100rpx;
}
.boxs {
	height: 120rpx;
	border-bottom: 1px solid #bbbbbb;
}
.boxs .sendMail {
	height: 60rpx;
	display: flex;
}
.boxs .pickUp {
	height: 60rpx;
	display: flex;
}
.items_l {
	width: 30%;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #101010;
}
.items_r {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #BBBBBB;
	font-size: 14px;
}
.remarks {
	height: 100rpx;
	display: flex;
}
.xing_txt {
	height: 80rpx;
	line-height: 80rpx;
	color: #F08718;
	padding-left: 20rpx;
	font-weight: 700;
}
