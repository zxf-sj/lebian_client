/* components/orderBottom/orderBottom.wxss */
.page {
	width: 100%;
}
.location {
	height: 240rpx;
	box-shadow: 0 2px 4px rgb(0, 0, 0,.4), 0 0 6px rgba(0, 0, 0, .04);
	margin: 30rpx 20rpx 0;
	border-radius: 10px;
}
.location .destination {
	display: flex;
    height: 50%;
    position: relative;
}
