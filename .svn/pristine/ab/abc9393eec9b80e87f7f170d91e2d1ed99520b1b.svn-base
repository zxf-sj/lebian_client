      success: function (res) {
        // 返回选定照片的本地文件路径列表，tempFilePath可以作为img标签的src属性显示图片
        that.setData({
          imgUrl: res.tempFiles // 将选择的图片路径设置到data中，用于显示
        });
        // 如果需要上传图片到服务器，可以使用res.tempFilePaths[0]作为参数进行上传
        // wx.uploadFile({
