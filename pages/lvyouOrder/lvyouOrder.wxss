page { background: #f0f4fa; }
.page { min-height: 100vh; padding-bottom: 200rpx; }

.card { margin: 24rpx; background: #fff; border-radius: 24rpx; padding: 28rpx; }
.card-title { font-size: 32rpx; font-weight: 700; color: #1a1a1a; margin-bottom: 24rpx; }

.date-row { display: flex; gap: 20rpx; }
.date-card {
  flex: 1; padding: 28rpx 0; background: #f4f9fb; border-radius: 16rpx;
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
  border: 4rpx solid transparent;
}
.date-card.on { border-color: #9b6cff; background: #f6f2ff; }
.date-md { font-size: 30rpx; color: #1a1a1a; }
.date-week { font-size: 26rpx; color: #5a6a7e; }

.pax-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; }
.pax-info { display: flex; flex-direction: column; gap: 8rpx; }
.pax-name { font-size: 32rpx; color: #1a1a1a; }
.pax-price { font-size: 24rpx; color: #99a5b5; }
.stepper { display: flex; align-items: center; gap: 24rpx; }
.step-btn {
  width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  background: #2e9eff; color: #fff; border-radius: 8rpx; font-size: 36rpx;
}
.step-num { font-size: 32rpx; color: #1a1a1a; min-width: 48rpx; text-align: center; }
.divider { border-top: 2rpx dashed #dfe6f0; margin: 12rpx 0; }

.total-label { font-size: 30rpx; color: #7a8a9e; }
.total-price { margin-top: 16rpx; font-size: 64rpx; color: #ff4d4f; font-weight: 800; }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; display: flex; gap: 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
}
.btn { flex: 1; height: 92rpx; line-height: 92rpx; text-align: center; border-radius: 999rpx; font-size: 34rpx; font-weight: 700; }
.btn.primary { background: #ff6b5b; color: #fff; box-shadow: 0 6rpx 16rpx rgba(255,107,91,0.4); }
.btn.ghost { background: #e3ecfb; color: #2a3444; }
