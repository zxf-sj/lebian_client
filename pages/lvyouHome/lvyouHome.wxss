page { background: #f0f4fa; }

.page { min-height: 100vh; padding-bottom: 40rpx; }

.hero { position: relative; padding: 60rpx 32rpx 200rpx; overflow: hidden; }
.hero-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0.35; }
.hero-mask { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background: linear-gradient(180deg, rgba(240,244,250,0.3), #f0f4fa); }
.hero-text { position: relative; z-index: 2; }
.hero-title { font-size: 48rpx; font-weight: 800; color: #1a1a1a; }
.hero-sub { margin-top: 12rpx; font-size: 26rpx; color: #5a6a7e; }

.search-box {
  position: relative; z-index: 2; margin-top: 40rpx;
  display: flex; align-items: center; background: #fff;
  border-radius: 999rpx; padding: 16rpx 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(46,120,255,0.1);
}
.search-input { flex: 1; font-size: 26rpx; color: #333; padding: 0 20rpx; }
.search-btn { font-size: 36rpx; padding: 0 10rpx; }

.city-row { white-space: nowrap; padding: 16rpx 24rpx; }
.city-pill {
  display: inline-block; padding: 14rpx 36rpx; margin-right: 16rpx;
  background: #e3ecfb; color: #2a3444; border-radius: 999rpx;
  font-size: 28rpx;
}
.city-pill.on { background: #2e9eff; color: #fff; font-weight: 600; }

.sort-row { display: flex; gap: 16rpx; padding: 0 24rpx 16rpx; }
.sort-pill {
  padding: 14rpx 32rpx; background: #e3ecfb; color: #2a3444;
  border-radius: 999rpx; font-size: 26rpx;
}
.sort-pill.filter { background: #2e9eff; color: #fff; }
.sort-pill.on { background: #2e9eff; color: #fff; }

.filter-card {
  margin: 0 24rpx 20rpx; background: #fff; border-radius: 24rpx;
  padding: 24rpx 28rpx;
}
.f-title { font-size: 30rpx; font-weight: 700; color: #1a1a1a; margin: 8rpx 0; }
.f-range { display: flex; justify-content: space-between; font-size: 24rpx; color: #99a5b5; margin-top: 8rpx; }
.f-slider { margin: 10rpx 0 20rpx; }
.f-days { display: flex; flex-wrap: wrap; gap: 16rpx; }
.day-pill {
  padding: 14rpx 32rpx; background: #e3ecfb; color: #2a3444;
  border-radius: 999rpx; font-size: 26rpx;
}
.day-pill.on { background: #2e9eff; color: #fff; font-weight: 600; }

.stat-row {
  display: flex; justify-content: space-between;
  padding: 12rpx 28rpx 20rpx; font-size: 24rpx; color: #7a8a9e;
}

.route-card {
  margin: 0 24rpx 24rpx; background: #fff; border-radius: 24rpx;
  padding: 28rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.route-head { display: flex; justify-content: space-between; align-items: flex-start; }
.route-title { flex: 1; font-size: 32rpx; font-weight: 700; color: #1a1a1a; }
.route-tag { flex-shrink: 0; margin-left: 16rpx; padding: 8rpx 20rpx; background: #e6f7ec; color: #3cb56a; border-radius: 999rpx; font-size: 24rpx; }
.route-line { margin-top: 16rpx; font-size: 26rpx; color: #5a6a7e; }
.route-pills { margin-top: 16rpx; display: flex; gap: 12rpx; }
.route-pill { padding: 6rpx 18rpx; background: #e6f7ec; color: #3cb56a; border-radius: 8rpx; font-size: 22rpx; }
.route-bottom { margin-top: 24rpx; display: flex; justify-content: space-between; align-items: baseline; }
.route-price { font-size: 40rpx; color: #ff4d4f; font-weight: 800; }
.route-price-unit { font-size: 24rpx; font-weight: 400; margin-left: 4rpx; }
.route-dates { font-size: 26rpx; color: #7a8a9e; }
