<view class="page">

  <!-- 顶部 Logo -->
  <view class="logo">
    <image class="logo-img" src="/assets/images/小程序3.0版.png" mode="aspectFit"></image>
  </view>

  <!-- 查询卡片 -->
  <view class="search-card">
    <!-- 出发地/目的地 -->
    <view class="route-row">
      <view class="route-item" bindtap="onPickCity" data-type="from">
        <text class="route-label">出发地</text>
        <view class="route-value">
          <text class="route-city">{{fromCity}}</text>
          <text class="route-arrow">▼</text>
        </view>
      </view>
      <view class="swap-btn" bindtap="onSwap">⇄</view>
      <view class="route-item route-item-right" bindtap="onPickCity" data-type="to">
        <text class="route-label">目的地</text>
        <view class="route-value">
          <text class="route-city">{{toCity}}</text>
          <text class="route-arrow">▼</text>
        </view>
      </view>
    </view>

    <!-- 日期 -->
    <picker mode="date" value="{{date}}" start="{{dateStart}}" end="{{dateEnd}}" bindchange="onDateChange">
      <view class="date-row">
        <text class="date-icon">📅</text>
        <text class="date-text">{{dateLabel}}</text>
      </view>
    </picker>

    <!-- 查询按钮 -->
    <view class="search-btn" bindtap="onSearch">
      <text class="search-btn-text">查询</text>
    </view>
  </view>

  <!-- 历史线路 -->
  <view class="section" wx:if="{{historyRoutes.length > 0}}">
    <view class="section-head">
      <text class="section-title">历史线路</text>
      <text class="section-sub">最近使用</text>
    </view>
    <view class="route-list">
      <view class="route-chip {{selectedKey=='history-'+index?'selected':''}}" wx:for="{{historyRoutes}}" wx:key="index" bindtap="onChipTap" data-route="{{item}}" data-group="history" data-index="{{index}}">
        <text class="chip-route">{{item.StatingLocation_Name}}→{{item.EndLocation_Name}}</text>
        <view class="chip-price">
          <text class="chip-label">最低</text>
          <text class="chip-amount">¥{{item.price}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 热门线路 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">热门线路</text>
      <text class="section-sub">点击填入上方</text>
    </view>
    <view class="route-list hot">
      <view class="route-chip {{selectedKey=='hot-'+index?'selected':''}}" wx:for="{{hotRoutes}}" wx:key="index" bindtap="onChipTap" data-route="{{item}}" data-group="hot" data-index="{{index}}">
        <text class="chip-route">{{item.startName}}→{{item.endName}}</text>
        <view class="chip-price">
          <text class="chip-label">最低</text>
          <text class="chip-amount">¥{{item.minPrice}}</text>
        </view>
      </view>
    </view>
  </view>

  <tabbar current="home"></tabbar>
</view>
