<view class="page">
  <!-- 顶部：出发地 / 目的地 / 出发日期（包车 tab 下隐藏，由 ch-top 替代） -->
  <view class="topbar" hidden="{{tab === 2}}">
    <view class="tb-col">
      <text class="tb-label">出发地</text>
      <text class="tb-value">{{from}}</text>
    </view>
    <view class="tb-swap" bindtap="onSwap">⇄</view>
    <view class="tb-col">
      <text class="tb-label">目的地</text>
      <text class="tb-value">{{to}}</text>
    </view>
    <view class="tb-col">
      <text class="tb-label">出发日期</text>
      <text class="tb-value">{{dateLabel}}</text>
    </view>
  </view>

  <!-- 日期：今天/明天/后天/第4天显示周几，固定四天（包车 tab 下隐藏） -->
  <view class="date-row" hidden="{{tab === 2}}">
    <view
      wx:for="{{dates}}"
      wx:key="full"
      class="date-cell {{dateIdx === index ? 'on' : ''}}"
      bindtap="onDateTap"
      data-idx="{{index}}"
      data-item="{{item}}"
    >
      <text class="dc-label">{{item.label}}</text>
      <text class="dc-md">{{item.md}}</text>
    </view>
  </view>

  <!-- 包车 tab 专用：通栏的三胶囊 + 上下车地址（在左右分栏之上） -->
  <view class="ch-top" wx:if="{{tab === 2}}">
    <!-- 时间段：提到最上面，点击弹出底部弹框选择 -->
    <view class="ch-timebar" bindtap="onOpenTimeSheet">
      <text class="ctb-label">出发时间段</text>
      <view class="ctb-val">
        <text class="ctb-time">{{tripTime || '请选择'}}</text>
        <text class="chc-arrow">▾</text>
      </view>
    </view>

    <view class="ch-trip">
      <view class="ch-chip tap" bindtap="onOpenDateSheet">
        <text class="chc-label">{{dates[dateIdx].label}}</text>
        <view class="chc-row">
          <text class="chc-md">{{dates[dateIdx].md}}</text>
          <text class="chc-arrow">▾</text>
        </view>
      </view>
      <view class="ch-chip wide">
        <text class="chc-route">{{from}} → {{to}}</text>
      </view>
      <view class="ch-chip">
        <text class="chc-price">¥{{vehPrice}}</text>
      </view>
    </view>

    <view class="ch-addr">
      <view class="ch-addr-row" bindtap="onPickAddr" data-direction="starting">
        <text class="ch-addr-city">{{from}}</text>
        <text class="ch-addr-text">{{addrFrom}}</text>
      </view>
      <view class="ch-addr-row" bindtap="onPickAddr" data-direction="ending">
        <text class="ch-addr-city">{{to}}</text>
        <text class="ch-addr-text">{{addrTo}}</text>
      </view>
    </view>
  </view>

  <view class="body">
    <!-- 左侧服务 tab -->
    <scroll-view class="side" scroll-y>
      <view
        wx:for="{{tabs}}"
        wx:key="name"
        class="side-item {{tab === item.id ? 'on' : ''}} {{item.badge ? 'has-badge' : ''}}"
        bindtap="onTabTap"
        data-item="{{item}}"
      >
        <text wx:if="{{item.badge}}" class="side-badge">{{item.badge}}</text>
        <text class="side-name">{{item.name}}</text>
        <text class="side-price">{{item.price}}</text>
      </view>
    </scroll-view>

    <!-- 右侧列：上面固定头部（仅站点上车），下面滚动内容 -->
    <view class="main-col">

    <!-- 站点上车 tab 下固定在顶部的热门站点块 -->
    <view class="station-fixed" wx:if="{{tab === 0}}">
      <view class="hot-card">
        <view class="hot-head">
          <text class="hot-title">🚏 热门站点</text>
          <text class="hot-count">已选{{hotCount}}个</text>
        </view>
        <view class="hot-pills">
          <view
            wx:for="{{hotStations}}"
            wx:key="index"
            class="hot-pill {{item.sel ? 'on' : ''}}"
            bindtap="onHotTap"
            data-idx="{{index}}"
          >{{item.Name}}</view>
        </view>
      </view>
      <view class="hot-link" bindtap="onOpenStationPage">点击进入选择上下车站点</view>
    </view>
    <!-- 拼车上门 tab 下固定的时段行 -->
    <view class="period-fixed" wx:if="{{tab === 1}}">
      <view class="period-row">
        <view
          wx:for="{{periods}}"
          wx:key="*this"
          class="period {{periodIdx === index ? 'on' : ''}}"
          bindtap="onPeriodTap"
          data-idx="{{index}}"
          data-item="{{item}}"
        >{{item}}</view>
      </view>
    </view>

    <scroll-view class="main" scroll-y>

      <!-- ========== 1. 站点上车 ========== -->
      <block wx:if="{{tab === 0}}">
        <view wx:for="{{stationRoutes}}" wx:key="time" class="st-card" bindtap="onBookStation" data-idx="{{index}}">
          <view class="st-main">
            <view class="st-head">
              <text class="st-time">{{item.Time}}</text>
              <text class="st-type" wx:if="{{item.IsStart}}">首发</text>
              <text class="st-type" wx:if="{{!item.IsStart}}">途径</text>
            </view>
            <view class="st-line">
              <view class="st-stop">
                <view class="st-dot blue"></view>
                <text class="st-stop-name">{{item.StartSiteName}}</text>
              </view>
              <view class="st-mids">
                <view wx:for="{{item.HotSiteList}}" wx:for-item="m" wx:key="index" class="st-pill">{{m.Name}}</view>
              </view>
              <view class="st-stop">
                <view class="st-dot red"></view>
                <text class="st-stop-name">{{item.EndSiteName}}</text>
              </view>
            </view>
          </view>
          <view class="st-side">
            <view class="st-vprices">
              <view class="st-vgroup">
                <text class="st-vcol">场站售票</text>
                <view class="st-vcol st-vnumcol">
                  <text class="st-vnum">{{item.SitePrice}}</text>
                  <text class="st-vunit">元 /位</text>
                </view>
              </view>
              <view class="st-vgroup plat">
                <text class="st-vcol">平台售票</text>
                <view class="st-vcol st-vnumcol">
                  <text class="st-vnum">{{item.TicketPrice}}</text>
                  <text class="st-vunit">元 /位</text>
                </view>
              </view>
            </view>
            <view class="st-ticket {{item.tickets <= 5 ? 'low' : ''}}">
              <text class="st-ticket-label">余票</text>
              <text class="st-ticket-num">{{item.EmptySeat}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- ========== 2. 拼车上门（点班次进下单页） ========== -->
      <block wx:elif="{{tab === 1}}">
        <view
          wx:for="{{carpoolShow}}"
          wx:key=index"
          class="cp-card {{item.sold ? 'sold' : ''}} {{carpoolSel === item.StartTime ? 'sel' : ''}}"
          bindtap="onCarpoolTap"
          data-item="{{item}}"
          data-index="{{index}}"
        >
          <view class="cp-left">
            <text class="cp-route">{{from}}→{{to}}</text>
            <text class="cp-time">{{item.StartTime}} ~ {{item.EndTime}}</text>
          </view>
          <view class="cp-right">
            <text class="cp-seats-label">余座</text>
            <text class="cp-seats">{{item.SeatNum}}</text>
          </view>
          <view wx:if="{{item.SeatNum == 0}}" class="stamp">SOLD OUT</view>
        </view>
      </block>

      <!-- ========== 3. 包车出发：右侧直接下单，不跳转 ========== -->
      <block wx:elif="{{tab === 2}}">
        <!-- 车型选择 -->
        <view wx:for="{{charterVeh}}" wx:key="name" class="veh-card {{vehSel === index ? 'sel' : ''}}" bindtap="onVehTap" data-idx="{{index}}">
          <view class="car_left">
            <view class="car_top">
              <text class="veh-name">{{item.name}}</text>
              <text wx:if="{{item.hot}}" class="veh-hot">限时特惠</text>
            </view>
            <view class="car_bot">
              <view class="veh-col">
                <text class="veh-cl">可乘坐</text>
                <text class="veh-cv">{{item.seats}}</text>
              </view>
              <view class="veh-col">
                <text class="veh-cl">价格</text>
                <text class="veh-cv price">¥{{item.price}}</text>
              </view>
            </view>
          </view>
          <view class="veh-right">
            <image src="{{item.img}}" mode="aspectFit" class="car_img"/>
          </view>
          <view class="veh-tag">{{item.tag}}</view>
        </view>

        <view class="form-row">
          <text class="form-label">联系方式</text>
          <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
        </view>
        <view class="form-row">
          <text class="form-label">乘车备注</text>
          <input class="form-input" placeholder="选填" value="{{remark}}" bindinput="onRemarkInput" />
        </view>

        <view class="notice">
          <text class="notice-line">※是否携带大件行李、飞机航班号、列车车次及乘坐时间、是否是孕妇或老人、是否是孩童单独乘车等，以便更好的为您服务。</text>
          <text class="notice-line">※儿童是指3岁以下的小朋友，每位成人乘客仅可享受一位儿童价优惠票。</text>
        </view>

        <view class="fee-row">
          <text class="fee-label">优惠券</text>
          <text class="fee-val link">可用3张&gt;</text>
        </view>
        <view class="fee-row">
          <text class="fee-label">订单总额</text>
          <text class="fee-val">¥{{vehPrice}}</text>
        </view>
        <view class="fee-row">
          <text class="fee-label">基本票价</text>
          <text class="fee-val">¥{{vehPrice}}</text>
        </view>
        <view class="fee-row total">
          <text class="fee-label">合计</text>
          <text class="fee-val price big">¥{{vehPrice}}</text>
        </view>

        <view class="agree" bindtap="onAgreeTap">
          <view class="agree-box {{agree ? 'on' : ''}}">{{agree ? '✓' : ''}}</view>
          <text class="agree-text">下单即同意本</text>
          <text class="agree-link">《服务条款》</text>
        </view>

        <view class="pay-btn" bindtap="onCharterPay">预约支付</view>
        <view class="gap"></view>

        
      </block>

      <!-- ========== 4. 跨城跑腿 ========== -->
      <block wx:else>
        <!-- 子tab：城际捎货 / 城际跑腿 -->
        <view class="er-sub">
          <view class="er-sub-item {{errandSub === 0 ? 'on' : ''}}" bindtap="onErrandSubTap" data-idx="0">城际捎货</view>
          <view class="er-sub-item {{errandSub === 1 ? 'on' : ''}}" bindtap="onErrandSubTap" data-idx="1">城际跑腿</view>
        </view>
        <view class="er-sub-tip">{{errandSub === 0 ? '按行李箱分类定价，提交后由客车捎带' : '代取 / 代点外卖，负责城际运输送达'}}</view>

        <!-- ===== 城际捎货 ===== -->
        <block wx:if="{{errandSub === 0}}">
          <view class="sec-head"><view class="sec-num">1</view><text class="sec-title">捎货时效</text></view>
          <view class="sec-label">时效 <text class="req">*</text></view>
          <view class="radio-item {{cargoSpeed === 0 ? 'on' : ''}}" bindtap="onCargoSpeedTap" data-idx="0">
            <view class="radio-dot"></view>
            <text class="radio-text">普通捎货：无时效限制，当时达或次日上午。</text>
          </view>
          <view class="radio-item {{cargoSpeed === 1 ? 'on' : ''}}" bindtap="onCargoSpeedTap" data-idx="1">
            <view class="radio-dot"></view>
            <text class="radio-text">加急捎货：+30元，不含溢价，按乘客流单。一程内必达。</text>
          </view>

          <view class="sec-head"><view class="sec-num">2</view><text class="sec-title">货物信息</text></view>
          <view class="sec-label">货物类别 <text class="req">*</text></view>
          <view class="radio-item {{cargoType === index ? 'on' : ''}}" wx:for="{{cargoTypes}}" wx:key="name" bindtap="onCargoTypeTap" data-idx="{{index}}">
            <view class="radio-dot"></view>
            <text class="radio-text">{{item.name}}</text>
          </view>
          <view class="sec-label">货物名称 <text class="req">*</text></view>
          <input class="er-input" placeholder="如：身份证、文件、小件衣物等。" value="{{cargoName}}" bindinput="onErInput" data-k="cargoName" />
          <view class="sec-label">货物照片 <text class="req">*</text></view>
          <view class="er-imgs">
            <view class="er-img" wx:for="{{cargoImgs}}" wx:key="*this">
              <image src="{{item}}" mode="aspectFill" class="er-img-pic" />
              <view class="er-img-del" bindtap="onCargoImgDel" data-idx="{{index}}">×</view>
            </view>
            <view class="er-img-add" wx:if="{{cargoImgs.length < 3}}" bindtap="onCargoImgAdd">
              <text class="er-img-add-icon">📷</text>
              <text>拍照/相册</text>
              <text class="er-img-count">{{cargoImgs.length}}/3</text>
            </view>
          </view>
          <view class="er-tip">捎货单必填至少 1 张物品照片，最多 3 张</view>

          <view class="sec-head"><view class="sec-num">3</view><text class="sec-title">寄件信息</text></view>
          <view class="er-cols">
            <view class="er-col">
              <view class="sec-label">称呼 <text class="req">*</text></view>
              <input class="er-input" placeholder="如：张先生" value="{{senderName}}" bindinput="onErInput" data-k="senderName" />
            </view>
            <view class="er-col">
              <view class="sec-label">电话 <text class="req">*</text></view>
              <input class="er-input" type="number" maxlength="11" placeholder="11位电话号码" value="{{senderPhone}}" bindinput="onErInput" data-k="senderPhone" />
            </view>
          </view>
          <view class="sec-label">取件地址 <text class="req">*</text></view>
          <input class="er-input" placeholder="如：太原市小店区XX路XX号" value="{{senderAddr}}" bindinput="onErInput" data-k="senderAddr" />

          <view class="sec-head"><view class="sec-num">4</view><text class="sec-title">收件信息</text></view>
          <view class="er-cols">
            <view class="er-col">
              <view class="sec-label">称呼 <text class="req">*</text></view>
              <input class="er-input" placeholder="如：张先生" value="{{receiverName}}" bindinput="onErInput" data-k="receiverName" />
            </view>
            <view class="er-col">
              <view class="sec-label">电话 <text class="req">*</text></view>
              <input class="er-input" type="number" maxlength="11" placeholder="11位电话号码" value="{{receiverPhone}}" bindinput="onErInput" data-k="receiverPhone" />
            </view>
          </view>
          <view class="sec-label">取件地址 <text class="req">*</text></view>
          <input class="er-input" placeholder="如：太原市小店区XX路XX号" value="{{receiverAddr}}" bindinput="onErInput" data-k="receiverAddr" />

          <view class="sec-head"><view class="sec-num">5</view><text class="sec-title">备注选填</text></view>
          <input class="er-input" placeholder="补充说明，如：到达后电话联系" value="{{cargoRemark}}" bindinput="onErInput" data-k="cargoRemark" />
        </block>

        <!-- ===== 城际跑腿 ===== -->
        <block wx:else>
          <view class="sec-head"><view class="sec-num">1</view><text class="sec-title">服务类型</text></view>
          <view class="radio-item {{runType === index ? 'on' : ''}}" wx:for="{{runTypes}}" wx:key="name" bindtap="onRunTypeTap" data-idx="{{index}}">
            <view class="radio-dot"></view>
            <text class="radio-text">{{item.name}}</text>
            <text class="radio-price">¥{{item.price}}</text>
          </view>

          <view class="sec-head"><view class="sec-num">2</view><text class="sec-title">点餐信息</text></view>
          <view class="sec-label">点餐店铺 <text class="req">*</text></view>
          <input class="er-input" placeholder="如：太原市XX餐厅" value="{{shopName}}" bindinput="onErInput" data-k="shopName" />
          <view class="sec-label">餐品要求 <text class="req">*</text></view>
          <input class="er-input" placeholder="如：两份牛肉面，少辣，打包" value="{{foodReq}}" bindinput="onErInput" data-k="foodReq" />

          <view class="sec-head"><view class="sec-num">3</view><text class="sec-title">送达信息</text></view>
          <view class="er-cols">
            <view class="er-col">
              <view class="sec-label">称呼 <text class="req">*</text></view>
              <input class="er-input" placeholder="如：张先生" value="{{runName}}" bindinput="onErInput" data-k="runName" />
            </view>
            <view class="er-col">
              <view class="sec-label">电话 <text class="req">*</text></view>
              <input class="er-input" type="number" maxlength="11" placeholder="11位电话号码" value="{{runPhone}}" bindinput="onErInput" data-k="runPhone" />
            </view>
          </view>
          <view class="sec-label">取件地址 <text class="req">*</text></view>
          <input class="er-input" placeholder="如：太原市小店区XX路XX号" value="{{runAddr}}" bindinput="onErInput" data-k="runAddr" />

          <view class="sec-head"><view class="sec-num">4</view><text class="sec-title">下单信息</text></view>
          <view class="sec-label">下单人联系电话 <text class="req">*</text></view>
          <input class="er-input" type="number" maxlength="11" placeholder="11位电话号码" value="{{orderPhone}}" bindinput="onErInput" data-k="orderPhone" />

          <view class="sec-head"><view class="sec-num">5</view><text class="sec-title">备注选填</text></view>
          <input class="er-input" placeholder="补充说明，如：到达后电话联系" value="{{runRemark}}" bindinput="onErInput" data-k="runRemark" />
        </block>

        <!-- 费用卡：基础/加急 + 合计 -->
        <view class="er-fee">
          <view class="er-fee-main">
            <view class="er-fee-row"><text>基础费用</text><text>{{erBase}}元</text></view>
            <view class="er-fee-row"><text>加急费用</text><text>{{erUrgent}}元</text></view>
          </view>
          <view class="er-fee-right">
            <text class="er-fee-ct">合计</text>
            <text class="er-fee-num">{{erTotal}}元</text>
          </view>
        </view>

        <view class="agree" bindtap="onErAgreeTap">
          <view class="agree-box {{erAgree ? 'on' : ''}}">{{erAgree ? '✓' : ''}}</view>
          <text class="agree-text">下单即同意本服务条款</text>
          <text class="agree-link">《用户须知》</text>
        </view>

        <view class="er-pay-btn" bindtap="onErrandPay">确 认 下 单</view>
        <view class="gap"></view>
      </block>

    </scroll-view>
    </view>
  </view>

  <!-- 包车：日期选择弹框（限今天起四天） -->
  <view class="mask" wx:if="{{dateSheetOpen}}" bindtap="onCloseSheets">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">选择出行日期</view>
      <scroll-view class="sheet-list" scroll-y>
        <view
          wx:for="{{dates}}"
          wx:key="full"
          class="sheet-item {{dateIdx === index ? 'on' : ''}}"
          bindtap="onDateSheetTap"
          data-idx="{{index}}"
        >
          <text class="si-label">{{item.label}}</text>
          <text class="si-md">{{item.full}}</text>
          <text class="si-check" wx:if="{{dateIdx === index}}">✓</text>
        </view>
      </scroll-view>
      <view class="sheet-tip">仅支持选择今天起 4 天内的日期</view>
    </view>
  </view>

  <!-- 包车：时间段选择弹框（选项由后端返回） -->
  <view class="mask" wx:if="{{timeSheetOpen}}" bindtap="onCloseSheets">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">选择时间段</view>
      <scroll-view class="sheet-list" scroll-y wx:if="{{charterTimes.length}}">
        <view
          wx:for="{{charterTimes}}"
          wx:key="label"
          class="sheet-item {{timeIdx === index ? 'on' : ''}}"
          bindtap="onTimeSheetTap"
          data-idx="{{index}}"
        >
          <text class="si-label">{{item.label}}</text>
          <text class="si-check" wx:if="{{timeIdx === index}}">✓</text>
        </view>
      </scroll-view>
      <view wx:else class="sheet-empty">{{timeLoading ? '时间段加载中…' : '当前日期暂无可选时间段'}}</view>
    </view>
  </view>
</view>
<kefu-float />
