page { background: #f4f6f9; }
.page { height: 100vh; display: flex; flex-direction: column; }

/* ===== 顶部线路栏 ===== */
.topbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 18rpx 12rpx 22rpx;
}
.tb-col { flex: 1; display: flex; flex-direction: column; align-items: center; }
.tb-label { font-size: 22rpx; color: #9aa3ad; }
.tb-value { font-size: 32rpx; font-weight: 700; color: #1a1a1a; margin-top: 6rpx; }
.tb-swap { width: 72rpx; text-align: center; font-size: 36rpx; color: #29a8e8; font-weight: 700; }

/* ===== 日期四格 ===== */
.date-row {
  flex-shrink: 0;
  display: flex;
  padding: 16rpx 16rpx 6rpx;
}
.date-cell {
  flex: 1;
  margin: 0 8rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: #eaf1fb;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.date-cell.on { background: #2ba9e8; box-shadow: 0 6rpx 16rpx rgba(43,169,232,.35); }
.dc-label { font-size: 28rpx; font-weight: 600; color: #1a1a1a; }
.dc-md { font-size: 26rpx; color: #6b7480; margin-top: 4rpx; }
.date-cell.on .dc-label, .date-cell.on .dc-md { color: #fff; }

/* ===== 主体：左 tab + 右内容 ===== */
.body { flex: 1; display: flex; overflow: hidden; }

.side { width: 150rpx; flex-shrink: 0; min-height: 0; background: #f4f6f9; }
.side-item {
  margin: 14rpx 10rpx;
  padding: 22rpx 0 16rpx;
  border-radius: 14rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.side-item.on { background: #2ba9e8; box-shadow: 0 6rpx 16rpx rgba(43,169,232,.35); }
.side-name { font-size: 28rpx; font-weight: 700; color: #1a1a1a; line-height: 38rpx; text-align: center; white-space: pre-line; }
.side-price { font-size: 24rpx; font-weight: 700; color: #e64340; margin-top: 8rpx; }
.side-item.on .side-name, .side-item.on .side-price { color: #fff; }

/* 左侧 tab 右上角"推荐"印章角标 */
.side-item.has-badge { position: relative; }
.side-badge {
  position: absolute;
  top: -10rpx;
  right: -14rpx;
  background: #e64340;
  color: #fff;
  font-size: 18rpx;
  line-height: 1;
  padding: 6rpx 8rpx;
  border-radius: 8rpx 8rpx 8rpx 0;
  transform: rotate(12deg);
  box-shadow: 0 2rpx 6rpx rgba(230,67,64,.4);
}

.main-col { flex: 1; min-height: 0; display: flex; flex-direction: column; min-width: 0; overflow: hidden; }

.station-fixed {
  flex-shrink: 0;
  padding: 12rpx 16rpx 0;
  background: #f4f6f9;
}

.period-fixed {
  flex-shrink: 0;
  padding: 12rpx 16rpx 0;
  background: #f4f6f9;
}

.main { flex: 1; min-height: 0; padding: 12rpx 16rpx 40rpx; box-sizing: border-box; }

/* ===== 1. 站点上车 ===== */
.hot-card { background: #e8f1fd; border-radius: 20rpx; padding: 24rpx; }
.hot-head { display: flex; align-items: baseline; }
.hot-title { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.hot-count { font-size: 26rpx; color: #6b7480; margin-left: 16rpx; }
.hot-pills { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.hot-pill {
  width: 30.5%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 30rpx;
  padding: 12rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #1a1a1a;
  margin: 0 4% 16rpx 0;
  white-space: nowrap;
  overflow: hidden;
}
.hot-pill:nth-child(3n) { margin-right: 0; }
.hot-pill.on { background: #2ba9e8; color: #fff; font-weight: 700; }
.hot-link {
  margin: 20rpx 0 6rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #e64340;
}

.st-card { display: flex; background: #e8f1fd; border-radius: 20rpx; padding: 24rpx 12rpx 24rpx 24rpx; margin-top: 22rpx; }
.st-main { flex: 1; min-width: 0; }
.st-head { display: flex; align-items: baseline; }
.st-time { font-size: 40rpx; font-weight: 700; color: #2ba9e8; letter-spacing: 2rpx; }
.st-type { font-size: 26rpx; color: #1a1a1a; margin-left: 16rpx; }

.st-line { position: relative; margin-top: 16rpx; }
.st-line::before {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 12rpx;
  bottom: 12rpx;
  width: 2rpx;
  background: #c3cede;
}
.st-stop { position: relative; display: flex; align-items: center; }
.st-dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 16rpx; flex-shrink: 0; }
.st-dot.blue { background: #2ba9e8; }
.st-dot.red { background: #e64340; }
.st-stop-name { font-size: 28rpx; font-weight: 700; color: #1a1a1a; }

.st-mids { display: flex; flex-wrap: wrap; margin: 14rpx 0 14rpx 36rpx; }
.st-pill {
  background: #fff;
  border-radius: 26rpx;
  padding: 8rpx 0;
  font-size: 25rpx;
  color: #1a1a1a;
  text-align: center;
  width: 150rpx;
  margin: 0 16rpx 14rpx 0;
}

.st-side { width: 148rpx; flex: none; display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 6rpx 0; }
.st-vprices { display: flex; flex-direction: row; align-items: stretch; }
.st-vgroup { display: flex; flex-direction: row; align-items: flex-start; }
.st-vgroup + .st-vgroup {
  border-left: 2rpx solid #c3cede;
  margin-left: 8rpx;
  padding-left: 8rpx;
}
.st-vcol {
  width: 24rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  text-align: center;
  word-break: break-all;
  color: #1a1a1a;
  margin-right: 6rpx;
}
.st-vcol:last-child { margin-right: 0; }
.st-vnumcol { width: auto; display: flex; flex-direction: column; align-items: center; }
.st-vnum { font-size: 22rpx; line-height: 28rpx; color: #1a1a1a; white-space: nowrap; }
.st-vunit { font-size: 22rpx; line-height: 28rpx; text-align: center; word-break: break-all; color: #1a1a1a; width: 24rpx; }
.st-vgroup.plat .st-vcol, .st-vgroup.plat .st-vnum, .st-vgroup.plat .st-vunit { color: #e64340; }
.st-ticket { display: flex; flex-direction: column; align-items: center; margin-top: 16rpx; }
.st-ticket-label { font-size: 26rpx; color: #1a1a1a; }
.st-ticket-num { font-size: 30rpx; font-weight: 700; color: #1a1a1a; margin-top: 6rpx; }
.st-ticket.low .st-ticket-label, .st-ticket.low .st-ticket-num { color: #e64340; }

/* ===== 2. 拼车上门 ===== */
.period-row { display: flex; margin: 8rpx 0 18rpx; }
.period {
  flex: 1;
  margin: 0 8rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #eaf1fb;
  font-size: 28rpx;
  color: #1a1a1a;
}
.period.on { background: #2ba9e8; color: #fff; font-weight: 700; }

.cp-card {
  position: relative;
  display: flex;
  align-items: center;
  background: #e8f1fd;
  border-radius: 18rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 22rpx;
  overflow: hidden;
}
.cp-card.sel { background: #2ba9e8; box-shadow: 0 8rpx 20rpx rgba(43,169,232,.35); }
.cp-card.sel .cp-route, .cp-card.sel .cp-time, .cp-card.sel .cp-seats-label, .cp-card.sel .cp-seats { color: #fff; }
.cp-card.sold { background: #cfd6de; }
.cp-card.sold .cp-route, .cp-card.sold .cp-time, .cp-card.sold .cp-seats-label, .cp-card.sold .cp-seats { color: #6b7480; }

.cp-left { flex: 1; display: flex; flex-direction: column; }
.cp-route { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.cp-time { font-size: 28rpx; color: #1a1a1a; margin-top: 8rpx; }
.cp-right { display: flex; flex-direction: column; align-items: center; }
.cp-seats-label { font-size: 26rpx; color: #1a1a1a; }
.cp-seats { font-size: 30rpx; font-weight: 700; color: #1a1a1a; margin-top: 4rpx; }

.stamp {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%) rotate(-12deg);
  border: 4rpx solid #d33;
  color: #d33;
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  opacity: .85;
}

/* ===== 3. 包车出发：右侧直接下单 ===== */

/* 包车 tab 顶部通栏：三胶囊 + 地址框（在左右分栏之上） */
.ch-top { padding: 12rpx 16rpx 0; }

/* 时间段条：包车顶部独立一条，点击弹框 */
.ch-timebar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eaf1fb;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
}
.ch-timebar:active { background: #dbe8fa; }
.ctb-label { font-size: 27rpx; color: #4a525c; margin-right: 16rpx; }
.ctb-val { display: flex; align-items: center; }
.ctb-time { font-size: 30rpx; font-weight: 700; color: #2ba9e8; }

/* 行程条三胶囊（日期 / 路线 / 价格 同一行） */
.ch-trip {
  display: flex;
  align-items: stretch;
  margin-bottom: 16rpx;
  gap: 16rpx;
}
.ch-chip {
  flex: 1;
  min-width: 0;
  background: #eaf1fb;
  border-radius: 16rpx;
  padding: 14rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ch-chip.wide { flex: 1.8; }
.ch-chip.tap:active { background: #dbe8fa; }
.chc-label { font-size: 28rpx; font-weight: 700; color: #1a1a1a; }
.chc-row { display: flex; align-items: center; margin-top: 4rpx; }
.chc-md { font-size: 26rpx; color: #4a525c; }
.chc-route { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.chc-arrow { font-size: 22rpx; color: #7b8593; margin-left: 6rpx; }
.chc-price { font-size: 34rpx; font-weight: 700; color: #1a1a1a; }

/* 底部弹框：日期 / 时间段 */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .45);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 30rpx 40rpx;
  box-sizing: border-box;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
  color: #1a1a1a;
}
.sheet-list { max-height: 560rpx; }
.sheet-item {
  display: flex;
  align-items: center;
  padding: 26rpx 10rpx;
  border-bottom: 2rpx solid #f0f2f5;
}
.sheet-item.on .si-label, .sheet-item.on .si-md { color: #2ba9e8; font-weight: 700; }
.si-label { font-size: 30rpx; color: #1a1a1a; }
.si-md { font-size: 28rpx; color: #6b7480; margin-left: 16rpx; }
.si-check { margin-left: auto; font-size: 30rpx; font-weight: 700; color: #2ba9e8; }
.sheet-tip { margin-top: 18rpx; font-size: 24rpx; color: #9aa3ad; text-align: center; }
.sheet-empty { padding: 50rpx 0; text-align: center; font-size: 28rpx; color: #9aa3ad; }

/* 上下车地址 */
.ch-addr { background: #e8f1fd; border-radius: 18rpx; padding: 8rpx 24rpx; margin-bottom: 24rpx; }
.ch-addr-row { display: flex; align-items: center; padding: 22rpx 0; }
.ch-addr-row + .ch-addr-row { border-top: 2rpx solid #d7e5f7; }
.ch-addr-city { width: 150rpx; font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.ch-addr-text { flex: 1; font-size: 27rpx; color: #4a525c; }

/* 车型卡 */
.veh-card {
  position: relative;
  display: flex;
  align-items: center;
  background: #e8f1fd;
  border-radius: 20rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid transparent;
}
.veh-card.sel { background: #2ba9e8; border-color: #2ba9e8; box-shadow: 0 8rpx 20rpx rgba(43,169,232,.35); }
.veh-card.sel .veh-name, .veh-card.sel .veh-cl, .veh-card.sel .veh-cv { color: #fff; }
.veh-card.sel .veh-cv.price { color: #ffd400; }

.car_left { flex: 1; min-width: 0; }
.car_top { display: flex; align-items: baseline; }
.veh-name { font-size: 28rpx; font-weight: 700; color: #1a1a1a; }
.veh-hot { font-size: 26rpx; font-weight: 400; font-style: normal; color: #e64340; margin-left: 10rpx; }
.veh-card.sel .veh-hot { color: #ffd400; }
.car_bot { display: flex; align-items: center; margin-top: 14rpx; }
.veh-col { display: flex; flex-direction: column; margin-right: 30rpx; }
.veh-cl { font-size: 24rpx; color: #6b7480; }
.veh-card.sel .veh-cl { color: rgba(255,255,255,.85); }
.veh-cv { font-size: 28rpx; font-weight: 700; color: #1a1a1a; margin-top: 4rpx; }
.veh-cv.price { color: #e64340; }

.veh-right { width: 210rpx; flex: none; display: flex; align-items: center; justify-content: flex-end; }
.car_img { width: 210rpx; height: 110rpx; }
.veh-origin { font-size: 24rpx; color: #9aa3ad; text-decoration: line-through; margin-left: 8rpx; }
.veh-ferry { margin-top: 6rpx; font-size: 22rpx; color: #e6940a; }

/* 表单 */
.form-row { display: flex; align-items: center; margin: 26rpx 0; }
.form-label { width: 160rpx; flex: none; font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.form-input { flex: 1; background: #e8f1fd; border-radius: 14rpx; height: 72rpx; padding: 0 24rpx; font-size: 28rpx; }

.notice { margin: 10rpx 0 20rpx; }
.notice-line { display: block; font-size: 24rpx; color: #e64340; line-height: 40rpx; }

/* 费用明细（参考 baoche 页） */
.details { box-sizing: border-box; padding: 0 10rpx; font-size: 24rpx; color: #999; }
.detailList {
  height: 60rpx;
  line-height: 60rpx;
  display: flex;
  padding: 0 10rpx;
  border-bottom: 2rpx solid #f0f2f5;
}
.detailList_l { height: 100%; width: 70%; text-align: left; font-size: 28rpx; color: #1a1a1a; }
.detailList_r { height: 100%; flex: 1; text-align: right; font-weight: 500; font-size: 28rpx; color: #1a1a1a; }
.city-empty { padding: 40rpx 0; text-align: center; font-size: 28rpx; color: #9aa3ad; }

.agree { display: flex; align-items: center; justify-content: center; margin: 22rpx 0 20rpx; }
.agree-box { width: 34rpx; height: 34rpx; border-radius: 6rpx; border: 2rpx solid #c3cede; display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: #fff; margin-right: 10rpx; }
.agree-box.on { background: #1aad19; border-color: #1aad19; }
.agree-text { font-size: 26rpx; color: #1a1a1a; }
.agree-link { font-size: 26rpx; color: #2ba9e8; font-weight: 700; }

.pay-btn {
  height: 96rpx; line-height: 96rpx; text-align: center;
  border-radius: 16rpx;
  background: #2ba9e8;
  color: #fff; font-size: 34rpx; font-weight: 600;
  margin-top: 30rpx;
}
.pay-btn:active { opacity: .85; }
.gap { height: 40rpx; }

/* 右侧悬浮客服圆按钮 */
.kefu-float {
  position: absolute;
  right: -8rpx;
  top: 360rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.15);
  overflow: hidden;
  border: 2rpx solid #fff;
}
.kefu-img { width: 100%; height: 100%; }

/* ===== 4. 跨城跑腿：城际捎货 / 城际跑腿 ===== */
.er-sub { display: flex; gap: 16rpx; margin-bottom: 12rpx; }
.er-sub-item {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #fff;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.er-sub-item.on { background: #2ba9e8; color: #fff; box-shadow: 0 6rpx 16rpx rgba(43,169,232,.35); }
.er-sub-tip { font-size: 24rpx; color: #9aa3ad; margin-bottom: 16rpx; }

/* 分节头：圆圈数字 + 标题 */
.sec-head { display: flex; align-items: center; margin: 26rpx 0 14rpx; }
.sec-num {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #2ba9e8; color: #fff;
  font-size: 24rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-right: 12rpx;
}
.sec-title { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.sec-label { font-size: 26rpx; color: #4a525c; margin: 16rpx 0 10rpx; }
.req { color: #e64340; }

/* 单选行 */
.radio-item {
  display: flex; align-items: flex-start;
  background: #fff; border-radius: 14rpx;
  padding: 20rpx 18rpx; margin-bottom: 14rpx;
}
.radio-dot {
  width: 30rpx; height: 30rpx; border-radius: 50%;
  border: 3rpx solid #c3cede; flex: none;
  margin-right: 14rpx; margin-top: 4rpx;
  box-sizing: border-box;
}
.radio-item.on .radio-dot {
  border-color: #2ba9e8;
  background: radial-gradient(circle, #2ba9e8 0 10rpx, #fff 11rpx 100%);
}
.radio-text { flex: 1; font-size: 27rpx; color: #1a1a1a; line-height: 40rpx; }
.radio-price { font-size: 28rpx; font-weight: 700; color: #e64340; margin-left: 12rpx; }

/* 输入框与两列 */
.er-input {
  background: #eaf1fb; border-radius: 14rpx;
  height: 76rpx; line-height: 76rpx;
  padding: 0 24rpx; font-size: 27rpx;
}
.er-cols { display: flex; gap: 20rpx; }
.er-col { flex: 1; min-width: 0; }

/* 货物照片 */
.er-imgs { display: flex; flex-wrap: wrap; gap: 16rpx; }
.er-img, .er-img-add {
  width: 150rpx; height: 150rpx;
  border-radius: 12rpx; position: relative;
}
.er-img-pic { width: 100%; height: 100%; border-radius: 12rpx; }
.er-img-del {
  position: absolute; top: -12rpx; right: -12rpx;
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: rgba(0,0,0,.55); color: #fff;
  font-size: 26rpx; line-height: 36rpx; text-align: center;
}
.er-img-add {
  background: #eaf1fb; border: 2rpx dashed #b9c6d8;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  font-size: 22rpx; color: #6b7480;
}
.er-img-add-icon { font-size: 36rpx; margin-bottom: 4rpx; }
.er-img-count { font-size: 20rpx; color: #9aa3ad; margin-top: 2rpx; }
.er-tip { font-size: 24rpx; color: #2ba9e8; margin-top: 12rpx; }

/* 费用卡 */
.er-fee {
  display: flex; align-items: center;
  background: #fff; border-radius: 16rpx;
  padding: 22rpx 26rpx; margin-top: 30rpx;
}
.er-fee-main { flex: 1; }
.er-fee-row {
  display: flex; justify-content: space-between;
  font-size: 27rpx; color: #1a1a1a;
  width: 260rpx; line-height: 48rpx;
}
.er-fee-right { display: flex; flex-direction: column; align-items: center; margin-left: 30rpx; }
.er-fee-ct { font-size: 27rpx; color: #1a1a1a; }
.er-fee-num { font-size: 32rpx; font-weight: 700; color: #e64340; margin-top: 4rpx; }

/* 确认下单：渐变胶囊按钮 */
.er-pay-btn {
  width: 320rpx; height: 88rpx; line-height: 88rpx;
  margin: 34rpx auto 0;
  border-radius: 44rpx;
  background: linear-gradient(90deg, #7fb2ff, #b6e3d2);
  color: #1a1a1a; font-size: 30rpx; font-weight: 700;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(127,178,255,.4);
}
.er-pay-btn:active { opacity: .85; }

/* ===== 包车：地址占位 ===== */
.ch-addr-ph { color: #b8c1cc; }

/* ===== 包车：用户须知弹框（参考 baoche 页） ===== */
.mask-center {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .5);
  z-index: 999;
}
.box_3 {
  background: #fefefe;
  width: 80%;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 10%;
  border-radius: 20rpx;
  padding: 0 20rpx;
}
.buttonsView {
  width: 80%;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 85%;
  display: flex;
}
.buttons1 { width: 130rpx; font-size: 28rpx; background: #d09c0a; color: #fff; }
.buttons2 { width: 130rpx; font-size: 28rpx; background: #e60c0c; color: #fff; }

/* ===== 包车：底部支付方式弹框（参考 baoche 页） ===== */
.pay-mask {
  position: fixed;
  left: 0; top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}
.pay-sheet {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.pay-sheet-head { display: flex; align-items: center; justify-content: center; position: relative; }
.pay-sheet-title { font-size: 34rpx; font-weight: 600; color: #010101; }
.pay-sheet-close {
  position: absolute;
  right: 0;
  top: -10rpx;
  font-size: 48rpx;
  line-height: 48rpx;
  color: #999;
  padding: 0 10rpx;
}
.pay-sheet-phone {
  margin-top: 16rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #F08718;
  letter-spacing: 2rpx;
}
.pay-sheet-label { margin: 32rpx 0 16rpx; font-size: 28rpx; color: #666; }

/* 支付立减优惠卡片 */
.pay-promo { margin-top: 24rpx; background: #fdf0ec; border-radius: 16rpx; padding: 20rpx 20rpx 22rpx; }
.pay-promo-head { display: flex; align-items: center; }
.pay-promo-icon {
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  background: linear-gradient(135deg, #ff7a45 0%, #e60c0c 100%);
  color: #fff; font-size: 26rpx; font-weight: 600; border-radius: 10rpx; flex-shrink: 0;
}
.pay-promo-title { margin-left: 12rpx; font-size: 28rpx; font-weight: 600; color: #e60c0c; }
.pay-promo-detail { margin-left: auto; display: flex; align-items: center; font-size: 26rpx; color: #e60c0c; padding: 6rpx 0 6rpx 20rpx; }
.pay-promo-arrow { margin-left: 6rpx; font-size: 24rpx; transition: transform 0.2s; }
.pay-promo-arrow-up { transform: rotate(180deg); }
.pay-promo-strip {
  margin-top: 16rpx;
  display: inline-block;
  background: linear-gradient(90deg, #ff8a3d 0%, #f5402a 100%);
  color: #fff; font-size: 24rpx; font-weight: 500; border-radius: 8rpx; padding: 8rpx 16rpx;
}
.pay-promo-list { margin-top: 16rpx; border-top: 2rpx dashed #f3c9bd; padding-top: 14rpx; }
.pay-promo-item { position: relative; font-size: 24rpx; color: #b3341f; line-height: 44rpx; padding-left: 24rpx; }
.pay-promo-item::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 18rpx;
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: #e60c0c;
}

/* 支付方式选项 */
.pay-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  background: #fafafa;
}
.pay-option-active { border-color: #F08718; background: #fff8ee; }
.pay-option-main { display: flex; align-items: center; }
.pay-option-logo { width: 56rpx; height: 56rpx; margin-right: 20rpx; flex-shrink: 0; border-radius: 8rpx; }
.pay-option-left { display: flex; flex-direction: column; }
.pay-option-name { font-size: 30rpx; color: #010101; font-weight: 500; }
.pay-option-tags { display: flex; align-items: center; margin-top: 10rpx; flex-wrap: wrap; }
.pay-option-tip { font-size: 24rpx; color: #e60c0c; margin-right: 12rpx; }
.pay-option-tag {
  font-size: 22rpx; color: #fff;
  background: linear-gradient(90deg, #ff6a3d 0%, #e60c0c 100%);
  border-radius: 6rpx; padding: 2rpx 12rpx;
}
.pay-radio {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  border: 2rpx solid #ccc; box-sizing: border-box; flex-shrink: 0;
}
.pay-radio-active { border: 12rpx solid #F08718; background: #fff; }
.pay-sheet-btn {
  margin-top: 24rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: linear-gradient(180deg, rgba(253, 209, 0, 1) 0%, rgba(240, 135, 24, 1) 100%);
  color: #fff; font-size: 32rpx; border-radius: 20rpx;
}
