page {
  background: #f4f6f9;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

.page {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* --- Logo --- */
.logo {
  padding: 36rpx 40rpx 16rpx;
}

.logo-img {
  width: 200rpx;
  height: 44rpx;
  display: block;
}

/* --- 查询卡片 --- */
.search-card {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.route-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.route-item {
  flex: 1;
}

.route-item-right {
  text-align: right;
}

.route-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.route-value {
  display: flex;
  align-items: baseline;
}

.route-item-right .route-value {
  justify-content: flex-end;
}

.route-city {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.route-arrow {
  font-size: 20rpx;
  color: #52c41a;
  margin-left: 6rpx;
}

.swap-btn {
  font-size: 40rpx;
  color: #2ba9e8;
  padding: 0 20rpx;
  margin-bottom: 4rpx;
}

.date-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0 32rpx;
  margin-top: 24rpx;
}

.date-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.date-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.search-btn {
  height: 96rpx;
  background: linear-gradient(135deg, #2ba9e8, #1a7fd4);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(43,169,232,0.3);
}

.search-btn-text {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
}

/* --- 线路区块 --- */
.section {
  margin: 30rpx 24rpx 0;
}

.section-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-right: 16rpx;
}

.section-sub {
  font-size: 24rpx;
  color: #bbb;
}

.route-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.route-chip {
  background: #e8f1fb;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  width: calc((100% - 32rpx) / 3);
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.route-list.hot .route-chip:nth-last-child(-n+3) {
  margin-bottom: 0;
}

.route-list:not(.hot) .route-chip:last-child {
  margin-bottom: 0;
}

.chip-route {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 4rpx;
  white-space: nowrap;
}

.chip-price {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.chip-label {
  font-size: 20rpx;
  color: #999;
}

.chip-amount {
  font-size: 26rpx;
  color: #ff4d4f;
  font-weight: 700;
}
