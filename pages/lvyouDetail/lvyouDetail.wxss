page { background: #f0f4fa; }
.page { min-height: 100vh; padding-bottom: 180rpx; }

.hero { position: relative; height: 360rpx; overflow: hidden; }
.hero-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.hero-mask { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background: linear-gradient(180deg, rgba(240,244,250,0.2), #f0f4fa); }
.hero-title {
  position: absolute; left: 32rpx; bottom: 40rpx; z-index: 2;
  font-size: 44rpx; font-weight: 800; color: #1a1a1a;
}

.card {
  margin: 24rpx; background: #fff; border-radius: 24rpx; padding: 28rpx;
}

.pills { display: flex; gap: 16rpx; }
.pill { padding: 8rpx 24rpx; background: #e6f7ec; color: #3cb56a; border-radius: 999rpx; font-size: 24rpx; }

.meta { margin-top: 24rpx; display: flex; gap: 40rpx; font-size: 28rpx; color: #2a3444; }

.price-row { margin-top: 32rpx; display: flex; gap: 24rpx; }
.price-box {
  flex: 1; background: #e3ecfb; border-radius: 20rpx;
  padding: 32rpx 0; text-align: center;
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
}
.price-label { font-size: 28rpx; color: #2a3444; }
.price-num { font-size: 48rpx; color: #ff4d4f; font-weight: 800; }
.price-unit { font-size: 24rpx; color: #5a6a7e; }

.card-title { font-size: 34rpx; font-weight: 800; color: #1a1a1a; margin-bottom: 24rpx; }

.timeline { padding-left: 8rpx; }
.tl-item { position: relative; padding-left: 36rpx; padding-bottom: 28rpx; }
.tl-dot { position: absolute; left: 0; top: 8rpx; width: 20rpx; height: 20rpx; border-radius: 50%; }
.tl-dot.blue { background: #2e9eff; }
.tl-dot.red { background: #ff4d4f; }
.tl-line { position: absolute; left: 9rpx; top: 30rpx; width: 2rpx; height: calc(100% - 20rpx); background: #d6e2f5; }
.tl-text { font-size: 28rpx; color: #2a3444; line-height: 1.6; }
.tl-day { font-weight: 700; }

.sub-title { font-size: 30rpx; color: #2a3444; margin: 20rpx 0 12rpx; }
.bullet { font-size: 28rpx; color: #5a6a7e; line-height: 1.9; }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; display: flex; gap: 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
}
.btn { flex: 1; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 999rpx; font-size: 32rpx; font-weight: 700; }
.btn.primary { background: #ff6b5b; color: #fff; box-shadow: 0 6rpx 16rpx rgba(255,107,91,0.4); }
.btn.ghost { background: #e3ecfb; color: #2a3444; }
