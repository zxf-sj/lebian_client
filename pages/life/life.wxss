.life-container {
  min-height: 100vh;
  background: #f0f4fa;
  padding: 32rpx 24rpx 120rpx;
  box-sizing: border-box;
}

.life-logo {
  padding: 24rpx 16rpx 40rpx;
}

.life-logo-img {
  width: 240rpx;
  height: 88rpx;
  display: block;
}

.life-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  padding: 0 8rpx;
}

.life-card {
  width: calc((100% - 24rpx) / 2);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 32rpx;
  background: #e3ecfb;
  box-shadow: 0 6rpx 18rpx rgba(46, 120, 255, 0.08);
  overflow: visible;
}

.life-card.on {
  background: #2e9eff;
  box-shadow: 0 8rpx 20rpx rgba(46, 158, 255, 0.3);
}

.life-card-img {
  width: 120rpx;
  height: 150rpx;
  flex-shrink: 0;
  /* 图标放大并向上探出卡片顶边，贴合设计图 */
  margin-top: -56rpx;
}

.life-card-name {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: #2a3444;
}

.life-card.on .life-card-name {
  color: #fff;
}
