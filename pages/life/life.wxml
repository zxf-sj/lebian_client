<view class="life-container">
  <!-- 顶部 logo -->
  <view class="life-logo">
    <image class="life-logo-img" src="/assets/images/小程序3.0版.png" mode="aspectFit"></image>
  </view>

  <!-- 2 列 3 行 服务卡片 -->
  <view class="life-grid">
    <view
      wx:for="{{services}}"
      wx:key="name"
      class="life-card {{item.active ? 'on' : ''}}"
      bindtap="onServiceTap"
      data-name="{{item.name}}"
      data-url="{{item.url}}"
    >
      <image class="life-card-img" src="{{item.img}}" mode="aspectFit"/>
      <text class="life-card-name">{{item.name}}</text>
    </view>
  </view>
</view>
<tabbar current="life"></tabbar>
<kefu-float />
