page { background: #f4f6f9; }

/* 上 3 / 下 4 分栏 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* ===== 上：图片轮播 ===== */
.img-panel {
  flex: 3;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 0 0 16rpx 16rpx;
  overflow: hidden;
}
.panel-head {
  padding: 20rpx 24rpx 12rpx;
  display: flex;
  flex-direction: column;
}
.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.panel-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #98a0ab;
}
.swiper-wrap {
  position: relative;
  flex: 1;
  min-height: 0;
  margin: 0 20rpx 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f4f6f9;
}
.img-swiper {
  width: 100%;
  height: 100%;
}
.swiper-img {
  width: 100%;
  height: 100%;
  display: block;
}
.img-counter {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, .45);
}
.img-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #98a0ab;
}

/* ===== 下：地图 ===== */
.map-panel {
  flex: 4;
  min-height: 0;
  position: relative;
}
.map {
  width: 100%;
  height: 100%;
  display: block;
}
.locate-btn {
  position: absolute;
  right: 24rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 26rpx;
  border-radius: 34rpx;
  background: #fff;
  color: #2f7cf6;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, .16);
}
.locate-icon {
  margin-right: 6rpx;
  font-size: 26rpx;
}
.nav-btn {
  position: absolute;
  right: 24rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: 40rpx;
  background: #2f7cf6;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(47, 124, 246, .35);
}
.nav-btn-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

/* ===== 导航方式选择弹层 ===== */
.nav-mask {
  position: fixed;
  left: 0; top: 0;
  width: 100%; height: 100%;
  background: rgba(0, 0, 0, .45);
  z-index: 30;
  display: flex;
  align-items: flex-end;
}
.nav-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.nav-sheet-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f2f5;
}
.nav-sheet-item {
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  font-size: 30rpx;
  color: #1a1a1a;
  border-bottom: 2rpx solid #f4f6f9;
}
.nav-sheet-cancel {
  margin-top: 16rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 30rpx;
  color: #666;
  background: #f4f6f9;
  border-radius: 12rpx;
}
