<!--pages/city/city.wxml-->
<view class="page">
  <view class="grid">
    <view
      class="item {{item.Alias === selected ? 'on' : ''}} {{item.IsOpen ? '' : 'IsOpen'}}"
      wx:for="{{cities}}"
      wx:key="Id"
      bindtap="onPick"
      data-item="{{item}}"
    >{{item.Alias}}</view>
  </view>
</view>
<kefu-float />
