<wxs module="sta">
  // 站名超过 10 个字：拆成两列紧挨着展示
  function cols(chars) {
    if (!chars || !chars.length) return [];
    if (chars.length <= 10) return [chars];
    var half = Math.ceil(chars.length / 2);
    return [chars.slice(0, half), chars.slice(half)];
  }
  // 竖排中需要旋转 90° 的符号：括号、斜杠、破折号等
  function rot(c) {
    if (!c) return false;
    return '（）()／/＼\\－—–·～~、，。'.indexOf(c) > -1;
  }
  module.exports = { cols: cols, rot: rot };
</wxs>

<view class="page">
  <!-- 顶部站点纵览：站点多时可左右滑动 -->
  <view class="sta-wrap">
    <!-- ① 箭头线：放在横滑区外面，宽度与 sta-scroll 一致（不随站点滚动变宽） -->
    <view class="sta-dash">
      <text class="sta-dash-arrow">→</text>
      <text class="sta-dash-arrow">→</text>
      <text class="sta-dash-arrow">→</text>
    </view>
    <scroll-view class="sta-scroll" scroll-x enhanced show-scrollbar="{{false}}" scroll-left="{{staScrollLeft}}" scroll-with-animation="{{true}}">
      <view class="sta-body">
        <view class="sta-row">
          <!-- 上车点列表（接口 StartSiteList） -->
          <view class="sta-col col-up" wx:for="{{upStations}}" wx:key="index">
            <!-- ② 选择圆圈 -->
            <view class="sta-mark {{item.mark === 'up' ? 'up' : ''}}" bindtap="onStaTap" data-kind="up" data-idx="{{index}}">
              <text wx:if="{{item.mark === 'up'}}">上</text>
            </view>
            <!-- ③ 站点名称（竖排，括号/斜杠等符号旋转） -->
            <view class="sta-name {{item.mark === 'up' ? 'green' : ''}}" bindtap="onStaTap" data-kind="up" data-idx="{{index}}">
              <view class="sta-name-col" wx:for="{{sta.cols(item.chars)}}" wx:for-item="col" wx:key="index">
                <text wx:for="{{col}}" wx:for-item="c" wx:key="index" class="sta-char {{sta.rot(c) ? 'rot' : ''}}">{{c}}</text>
              </view>
            </view>
            <!-- ④ 图片示意（可点开大图） -->
            <view class="sta-img-box" bindtap="onStaImgTap" data-kind="up" data-idx="{{index}}">
              <image class="sta-img" src="/assets/images/map_mark.png" mode="aspectFill"></image>
            </view>
          </view>
          <!-- 下车点列表（接口 EndSiteList）：首列画分割线 -->
          <view
            class="sta-col col-down {{upStations.length && index === 0 ? 'col-split' : ''}}"
            wx:for="{{downStations}}" wx:key="index"
          >
            <!-- ② 选择圆圈 -->
            <view class="sta-mark {{item.mark === 'down' ? 'down' : ''}}" bindtap="onStaTap" data-kind="down" data-idx="{{index}}">
              <text wx:if="{{item.mark === 'down'}}">下</text>
            </view>
            <!-- ③ 站点名称（竖排，括号/斜杠等符号旋转） -->
            <view class="sta-name {{item.mark === 'down' ? 'red' : ''}}" bindtap="onStaTap" data-kind="down" data-idx="{{index}}">
              <view class="sta-name-col" wx:for="{{sta.cols(item.chars)}}" wx:for-item="col" wx:key="index">
                <text wx:for="{{col}}" wx:for-item="c" wx:key="index" class="sta-char {{sta.rot(c) ? 'rot' : ''}}">{{c}}</text>
              </view>
            </view>
            <!-- ④ 图片示意（可点开大图） -->
            <view class="sta-img-box" bindtap="onStaImgTap" data-kind="down" data-idx="{{index}}">
              <image class="sta-img" src="/assets/images/map_mark.png" mode="aspectFill"></image>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
    <!-- 横滑提示：站点超出一屏时展示，自动消失 -->
    <view class="swipe-tip" wx:if="{{showStaTip}}">
      <text class="swipe-tip__txt">左右滑动查看更多</text>
      <text class="swipe-tip__arrow">›</text>
    </view>
    <!-- 图例：区分上车点 / 下车点 -->
    <!-- <view class="sta-legend">
      <view class="lg-item"><view class="lg-dot up"></view><text class="lg-txt">上车点 · {{upCity}}</text></view>
      <view class="lg-item"><view class="lg-dot down"></view><text class="lg-txt">下车点 · {{downCity}}</text></view>
    </view> -->
  </view>

  <!-- 上下车点 / 乘车人 -->
  <view class="card">
    <view class="pick-row" bindtap="onPickUp">
      <text class="pick-city">{{upCity}}</text>
      <text class="pick-label {{upStation ? 'picked' : ''}}">{{upStation || '选择上车点'}}</text>
      <text class="pick-arrow">⌄</text>
    </view>
    <!-- 上车点对应站点的发车时间（StartSiteList.ArrivalTime） -->
    <view class="pick-time" wx:if="{{upTime}}">
      <text class="pick-time-label">{{upTimeLabel}}</text>
      <text class="pick-time-val">{{upTime}}</text>
    </view>
    <view class="line"></view>
    <view class="pick-row" bindtap="onPickDown">
      <text class="pick-city">{{downCity}}</text>
      <text class="pick-label {{downStation ? 'picked' : ''}}">{{downStation || '选择下车点'}}</text>
      <text class="pick-arrow">⌄</text>
    </view>
    <!-- 下车点对应站点的到达时间（EndSiteList.ArrivalTime） -->
    <view class="pick-time" wx:if="{{downTime}}">
      <text class="pick-time-label">{{downTimeLabel}}</text>
      <text class="pick-time-val">{{downTime}}</text>
    </view>
    <view class="line"></view>

    <!-- 乘车人列表：多选，选中的人逐行显示明细 -->
    <view class="psg-head">
      <!-- scroll-view 必须放在定宽容器里：真机上 flex:1 直接作用在 scroll-view 会导致横滑失效 -->
      <view class="psg-names-wrap">
        <scroll-view class="psg-names" scroll-x enhanced show-scrollbar="{{false}}" scroll-left="{{psgScrollLeft}}" scroll-with-animation="{{true}}">
          <view class="psg-names-inner">
            <view
              wx:for="{{passengers}}" wx:key="id"
              class="psg-tag {{item.selected ? 'on' : ''}}"
              bindtap="onPaxTab" data-idx="{{index}}"
            >
              {{item.name}}
              <text wx:if="{{item.selected}}" class="psg-tick">✓</text>
              <text wx:if="{{item.isChild}}" class="psg-child">儿童</text>
            </view>
          </view>
        </scroll-view>
        <!-- 横滑提示：乘车人超出一屏时展示，自动消失 -->
        <view class="swipe-tip" wx:if="{{showPsgTip}}">
          <text class="swipe-tip__txt">左右滑动查看更多</text>
          <text class="swipe-tip__arrow">›</text>
        </view>
      </view>
      <view class="psg-add" bindtap="onAddUser">新增</view>
    </view>
    <block wx:for="{{passengers}}" wx:key="id">
      <view wx:if="{{item.selected}}" class="psg-row">
        <text class="psg-name">{{item.name}}</text>
        <text class="psg-type">{{item.type}}</text>
        <text class="psg-phone">{{item.idCard}}</text>
        <text class="psg-price">¥{{item.isChild ? childPrice : platformPrice}}</text>
      </view>
    </block>
    <view wx:if="{{!psgCount}}" class="psg-none">请选择乘车人</view>
  </view>

  <!-- 优惠方式 -->
  <view class="card coupon-row" bindtap="onCoupon">
    <text class="coupon-label">优惠方式</text>
    <text class="coupon-none">未使用></text>
  </view>

  <!-- 乘车须知 -->
  <view class="card notice">
    <!-- 服务合同勾选放在须知最上面，默认已勾选 -->
    <view class="notice-agree" bindtap="onAgree">
      <view class="cb {{agree ? 'on' : ''}}">{{agree ? '✓' : ''}}</view>
      <text class="agree-txt">我接受服务合同</text>
    </view>
    <view class="notice-title">乘车安全须知：</view>
    <view class="notice-p">感谢您使用本平台!为了您和他人的安全，请务必仔细阅读，感谢配合!</view>
    <view class="notice-h">车辆行驶规定:</view>
    <view class="notice-p">车辆运行过程中请配合公检法(22-0806)，每2小时停车休息20分钟，凌晨2:00至5:00禁止运行。未拼车连车不可开超过限速及高速360公里/公里，请全程系好安全带。</view>
    <view class="notice-p">班次售完即止，请提前24小时以上-坐不满取消，24小时至2小时内取消需缴纳全额20%手续费，发生20分钟内-需缴纳全额20%手续费，发生3分钟内取消将不予退费。</view>
    <view class="notice-h">改签退票规定:</view>
    <view class="notice-p">请在开车3-5个工作日前办理改签退票业务。</view>
    <view class="notice-p">特别提示:改签将产生改签补差费用。</view>
    <view class="notice-p">在线改签-特价票改签需要购买改签的车票2次不可改签，仅可改签一次(改签后乘车时间不变，改签一次仅可改签乘车时间，改签不支持不退票)。</view>
    <view class="notice-h">儿童及携童规定:</view>
    <view class="notice-p">按照交通运输部《民用运输服务管理规定》及《汽车客运规定》等文件要求：儿童需实名，不占座不运行书客运手续上，不运行书客运手续上。</view>
    <view class="notice-p">儿童票标准:6周岁(含)以下或1.2米以下免费乘车(不占座，需成人携带)。6-14周岁或1.2-1.5米可购买儿童优惠票。每名成年旅客可免费携带一名不单独占座的儿童，超过人数时需购买儿童票。</view>
    <view class="notice-h">禁止携带物品:</view>
    <view class="notice-p">按照《反恐怖主义法》和《危险化学品安全管理条例》等法律法规，严禁携带易燃、易爆、有毒、有放射性、腐蚀性等危险品及国家明令禁止的其它物品乘车。</view>
    <view class="notice-p">行李限重:免费携带品的重量/规格:每件外部尺寸长、宽、高之和不超过160厘米，重量不超过20千克。超长、超宽物品需另行办理托运。</view>
  </view>

  <!-- 底部支付栏 -->
  <view class="paybar">
    <view class="pay-left">
      <text class="pay-amount">订单金额：<text class="pay-num">¥{{total}}</text></text>
    </view>
    <view class="pay-detail" bindtap="onDetail">
      <text>明细</text>
      <text class="pay-tri {{detailOpen ? 'up' : ''}}">▲</text>
    </view>
    <view class="pay-btn" bindtap="onPay">下单并支付</view>
  </view>

  <!-- 站点选择弹层（站点可能超过 6 个，不用 showActionSheet） -->
  <view class="sta-pick-mask" wx:if="{{staPickShow}}" bindtap="closeStaPick">
    <view class="sta-pick-sheet" catchtap="noop">
      <view class="sta-pick-head">
        <text class="sta-pick-title">{{staPickType === 'up' ? '选择上车点' : '选择下车点'}}</text>
        <text class="sta-pick-close" catchtap="closeStaPick">×</text>
      </view>
      <scroll-view class="sta-pick-list" scroll-y>
        <view
          class="sta-pick-item {{item.mark === staPickType ? 'on' : ''}}"
          wx:for="{{staPickList}}" wx:key="idx"
          data-idx="{{item.idx}}" catchtap="onStaPick"
        >
          <text class="sta-pick-name">{{item.name}}</text>
          <text class="sta-pick-time" wx:if="{{item.time}}">{{staPickType === 'up' ? '预计发车时间' : '预计到达时间'}}{{item.time}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 明细弹层 -->
  <view class="mask" wx:if="{{detailOpen}}" bindtap="onDetail">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">费用明细</view>
      <view class="sheet-row" wx:if="{{adultCount}}"><text>成人票</text><text>¥{{platformPrice}} × {{adultCount}}</text></view>
      <view class="sheet-row" wx:if="{{childCount}}"><text>儿童票</text><text>¥{{childPrice}} × {{childCount}}</text></view>
      <view class="sheet-row total"><text>合计</text><text>¥{{total}}</text></view>
    </view>
  </view>

  <!-- 底部支付方式弹框（微信支付 / 云闪付） -->
  <view class="pay-mask" wx:if="{{paySheetShow}}" catchtouchmove="noop" bind:tap="cancelPaySheet">
    <view class="pay-sheet" catchtap="noop">
      <view class="pay-sheet-head">
        <view class="pay-sheet-title">确认支付</view>
        <view class="pay-sheet-close" catchtap="cancelPaySheet">×</view>
      </view>
      <view class="pay-sheet-phone">¥{{total}}</view>

      <view class="pay-promo">
        <view class="pay-promo-head">
          <view class="pay-promo-icon">¥</view>
          <view class="pay-promo-title">支付立减优惠</view>
          <view class="pay-promo-detail" catchtap="togglePayPromoDetail">
            <text>详情</text>
            <text class="pay-promo-arrow {{payPromoDetailShow ? 'pay-promo-arrow-up' : ''}}">∨</text>
          </view>
        </view>
        <view class="pay-promo-strip">云闪付支付｜至高立减20元｜每日名额有限</view>
        <view class="pay-promo-list" wx:if="{{payPromoDetailShow}}">
          <view class="pay-promo-item" wx:for="{{payPromoRules}}" wx:key="*this">{{item}}</view>
        </view>
      </view>

      <view class="pay-sheet-label">支付方式</view>
      <view class="pay-option {{payType === item.key ? 'pay-option-active' : ''}}" wx:for="{{payTypeList}}" wx:key="key" data-key="{{item.key}}" catchtap="onPayTypeChange">
        <view class="pay-option-main">
          <image src="{{item.img}}" class="pay-option-logo" mode="aspectFit"></image>
          <view class="pay-option-left">
            <view class="pay-option-name">{{item.name}}</view>
            <view class="pay-option-tags" wx:if="{{item.tip}}">
              <text class="pay-option-tip">{{item.tip}}</text>
            </view>
          </view>
        </view>
        <view class="pay-radio {{payType === item.key ? 'pay-radio-active' : ''}}"></view>
      </view>

      <view class="pay-sheet-btn" catchtap="confirmPaySheet">确认支付并下单</view>
    </view>
  </view>
</view>
<kefu-float />
