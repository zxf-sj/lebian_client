page { background: #f4f6f9; }
.page { padding: 16rpx 16rpx 140rpx; box-sizing: border-box; }

/* ===== 顶部站点纵览 ===== */
.sta-wrap {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 10rpx 20rpx;
  margin-bottom: 16rpx;
}
/* 站点横滑区：线路站点多时可左右滑动，少时自动撑满 */
.sta-scroll { width: 100%; }
.sta-body { display: inline-block; vertical-align: top; min-width: 100%; box-sizing: border-box; }
.sta-row { display: flex; align-items: flex-start; min-width: 100%; }
/* 每列最小 68rpx：10 站以内均分撑满，超过 10 站横向滑动 */
.sta-col { flex: 1 0 68rpx; display: flex; flex-direction: column; align-items: center; }

/* 上车点 / 下车点分组：分界处画一条竖向虚线（不占宽度，不影响圆点与时间对齐） */
.sta-col.col-split { position: relative; }
.sta-col.col-split::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  border-left: 2rpx dashed #c8cdd4;
}

/* 图例 */
.sta-legend {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 12rpx 0;
}
.lg-item { display: flex; align-items: center; }
.lg-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 10rpx; box-sizing: border-box; }
.lg-dot.up { border: 3rpx solid #1aad19; }
.lg-dot.down { border: 3rpx solid #e64340; }
.lg-txt { font-size: 22rpx; color: #8a94a2; }

/* 站名：竖排，每列一字；超 10 字自动分两列紧挨着，顶部与圆圈相接 */
.sta-name {
  /* min-height: 232rpx; */
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.25;
}
.sta-name-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.sta-name-col + .sta-name-col { margin-left: 2rpx; }
.sta-name.green { color: #1aad19; }
.sta-name.red { color: #e64340; }
/* 竖排中的括号、斜杠等符号旋转 90°，符合竖排书写习惯 */
.sta-char.rot { transform: rotate(90deg); }

/* 选择圆圈：位于箭头线之下、站名之上 */
.sta-mark {
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 12rpx;
  border-radius: 50%;
  border: 2rpx solid #c8cdd4;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #98a0ab;
  background: #fff;
}
.sta-mark.up { border-color: #1aad19; color: #1aad19; }
.sta-mark.down { border-color: #e64340; color: #e64340; }

/* ④ 站点图片示意：可点开大图 */
.sta-img-box {
  position: relative;
  width: 26rpx;
  height: 34rpx;
  margin-top: 12rpx;
  overflow: hidden;
  box-sizing: border-box;
}
.sta-img { width: 100%; height: 100%; display: block; }
.sta-img-zoom {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 22rpx;
  height: 22rpx;
  line-height: 22rpx;
  text-align: center;
  font-size: 16rpx;
  color: #fff;
  background: rgba(0, 0, 0, .45);
  border-radius: 8rpx 0 0 0;
}

/* 虚线分隔：线上三个向右箭头（箭头底色压住虚线）
   位于横滑区之外，宽度与 .sta-scroll 一致，站点横向滚动时长度不变 */
.sta-dash {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-around;
  width: 100%;
  box-sizing: border-box;
  height: 44rpx;
  margin: 0 0 16rpx;
}
.sta-dash::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  border-top: 2rpx dashed #c8cdd4;
}
.sta-dash-arrow {
  position: relative;
  z-index: 1;
  padding: 0 14rpx;
  background: #fff;
  color: #2f7cf6;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

/* 时间：竖排两行 */
.sta-time {
  font-size: 26rpx;
  color: #1a1a1a;
  line-height: 1.3;
  text-align: center;
}

/* ===== 通用卡片 ===== */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 16rpx;
}

/* 选择上/下车点、乘车人 */
.pick-row {
  display: flex;
  align-items: center;
  height: 96rpx;
}
.pick-row.center { justify-content: center; }
.pick-city {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  width: 160rpx;
  flex: none;
}
.pick-label {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.pick-label.picked { color: #2f7cf6; }
.pick-label.mid { flex: none; }
.pick-arrow {
  font-size: 34rpx;
  color: #2f7cf6;
  flex: none;
}
/* 站点对应时间：标签灰色、时间醒目 */
.pick-time {
  display: flex;
  align-items: center;
  margin: -8rpx 0 12rpx;
}
.pick-time-label {
  font-size: 24rpx;
  color: #98a0ab;
}
.pick-time-val {
  margin-left: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2f7cf6;
}
.line { border-top: 2rpx solid #f0f2f5; }

/* 乘车人头部：标签可横向滑动，新增固定在最右侧 */
.psg-head {
  display: flex;
  align-items: center;
  padding: 12rpx 0 8rpx;
}
/* 定宽包裹层：scroll-view 宽度由它决定，真机才能正常横滑 */
.psg-names-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.psg-names {
  width: 100%;
  white-space: nowrap;
}
/* 真机只有 inline-block 内容才能撑出横向滚动宽度 */
.psg-names-inner {
  display: inline-block;
  white-space: nowrap;
  font-size: 0;
  /* 上下留白避免选中角标、儿童标被 scroll-view 裁掉 */
  padding: 18rpx 14rpx 6rpx;
}
.psg-tag {
  position: relative;
  display: inline-block;
  vertical-align: middle;
  margin-right: 16rpx;
  min-width: 76rpx;
  padding: 6rpx 18rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.5;
  color: #666;
  border-radius: 8rpx;
  background: #f4f6f9;
}
.psg-tag.on {
  color: #2f7cf6;
  font-weight: 700;
  background: #e8f1fd;
  border: 2rpx solid #2f7cf6;
}
.psg-child {
  position: absolute;
  top: -14rpx;
  right: -10rpx;
  font-size: 18rpx;
  color: #fff;
  background: #ff8f1f;
  border-radius: 8rpx 8rpx 8rpx 0;
  padding: 0 8rpx;
  line-height: 26rpx;
}
.psg-add {
  flex: none;
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #2f7cf6;
}
/* 多选选中角标（左上，儿童标在右上，互不冲突） */
.psg-tick {
  position: absolute;
  top: -14rpx;
  left: -10rpx;
  font-size: 18rpx;
  color: #fff;
  background: #2f7cf6;
  border-radius: 8rpx 0 8rpx 8rpx;
  padding: 0 8rpx;
  line-height: 26rpx;
}
.psg-none { padding: 8rpx 0 24rpx; font-size: 26rpx; color: #999; text-align: center; }

/* 乘车人明细行 */
.psg-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0 24rpx;
  font-size: 28rpx;
  color: #1a1a1a;
}
.psg-name { font-weight: 700; margin-right: 28rpx; width: 100rpx; }
.psg-type { color: #666; margin-right: 28rpx; }
.psg-phone { flex: 1; font-size: 26rpx; color: #333; }
.psg-price { font-weight: 700; }

/* ===== 优惠方式 ===== */
.coupon-row {
  display: flex;
  align-items: center;
  height: 100rpx;
  padding: 0 24rpx;
}
.coupon-label { font-size: 32rpx; font-weight: 700; color: #1a1a1a; }
.coupon-none {
  margin-left: auto;
  font-size: 28rpx;
  color: #98a0ab;
}

/* ===== 乘车须知 ===== */
.notice { padding: 24rpx; }
.notice-title { font-size: 26rpx; font-weight: 700; color: #1a1a1a; margin-bottom: 8rpx; }
.notice-h { font-size: 24rpx; font-weight: 700; color: #1a1a1a; margin-top: 14rpx; }
.notice-p {
  font-size: 22rpx;
  color: #8a94a2;
  line-height: 1.6;
  margin-top: 4rpx;
}
.notice-agree {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin: 0 0 12rpx;
}
.cb {
  width: 34rpx;
  height: 34rpx;
  border-radius: 6rpx;
  border: 2rpx solid #c8cdd4;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  margin-right: 10rpx;
}
.cb.on { background: #1aad19; border-color: #1aad19; }
.agree-txt { font-size: 28rpx; font-weight: 700; color: #1a1a1a; }

/* ===== 底部支付栏 ===== */
.paybar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  background: #fff;
  border-top: 2rpx solid #f0f2f5;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.pay-left { flex: 1; min-width: 0; }
.pay-amount { font-size: 28rpx; color: #1a1a1a; }
.pay-num { font-size: 34rpx; font-weight: 700; color: #e64340; }
.pay-detail {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #2f7cf6;
  margin-right: 20rpx;
}
.pay-tri { font-size: 20rpx; margin-left: 6rpx; transition: transform .2s; }
.pay-tri.up { transform: rotate(180deg); }
.pay-btn {
  flex: none;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 44rpx;
  border-radius: 12rpx;
  background: #2f7cf6;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

/* ===== 站点选择弹层 ===== */
.sta-pick-mask {
  position: fixed;
  left: 0; top: 0;
  width: 100%; height: 100%;
  background: rgba(0, 0, 0, .45);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}
.sta-pick-sheet {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.sta-pick-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f2f5;
}
.sta-pick-title { font-size: 32rpx; font-weight: 700; color: #1a1a1a; }
.sta-pick-close {
  position: absolute;
  right: 0;
  top: -6rpx;
  font-size: 44rpx;
  line-height: 44rpx;
  color: #999;
  padding: 0 8rpx;
}
.sta-pick-list { max-height: 56vh; padding-top: 8rpx; }
.sta-pick-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 16rpx;
  border-bottom: 2rpx solid #f4f6f9;
  font-size: 30rpx;
  color: #1a1a1a;
}
.sta-pick-item.on { color: #2f7cf6; font-weight: 700; background: #f2f7ff; border-radius: 12rpx; }
.sta-pick-name { flex: 1; min-width: 0; }
.sta-pick-time { font-size: 26rpx; color: #98a0ab; margin-left: 20rpx; flex: none; }
.sta-pick-item.on .sta-pick-time { color: #2f7cf6; }

/* ===== 明细弹层 ===== */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .45);
  display: flex;
  align-items: flex-end;
  z-index: 10;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 30rpx 50rpx;
  box-sizing: border-box;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}
.sheet-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #666;
  padding: 14rpx 0;
}
.sheet-row.total { color: #1a1a1a; font-weight: 700; border-top: 2rpx solid #f0f2f5; }

/* ===== 底部支付方式弹框（与 rideOrder 一致） ===== */
.pay-mask {
  position: fixed;
  left: 0; top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}
.pay-sheet {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.pay-sheet-head { display: flex; align-items: center; justify-content: center; position: relative; }
.pay-sheet-title { font-size: 34rpx; font-weight: 600; color: #010101; }
.pay-sheet-close {
  position: absolute;
  right: 0;
  top: -10rpx;
  font-size: 48rpx;
  line-height: 48rpx;
  color: #999;
  padding: 0 10rpx;
}
.pay-sheet-phone {
  margin-top: 16rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #F08718;
  letter-spacing: 2rpx;
}
.pay-sheet-label { margin: 32rpx 0 16rpx; font-size: 28rpx; color: #666; }

.pay-promo { margin-top: 24rpx; background: #fdf0ec; border-radius: 16rpx; padding: 20rpx 20rpx 22rpx; }
.pay-promo-head { display: flex; align-items: center; }
.pay-promo-icon {
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  background: linear-gradient(135deg, #ff7a45 0%, #e60c0c 100%);
  color: #fff; font-size: 26rpx; font-weight: 600; border-radius: 10rpx; flex-shrink: 0;
}
.pay-promo-title { margin-left: 12rpx; font-size: 28rpx; font-weight: 600; color: #e60c0c; }
.pay-promo-detail { margin-left: auto; display: flex; align-items: center; font-size: 26rpx; color: #e60c0c; padding: 6rpx 0 6rpx 20rpx; }
.pay-promo-arrow { margin-left: 6rpx; font-size: 24rpx; transition: transform 0.2s; }
.pay-promo-arrow-up { transform: rotate(180deg); }
.pay-promo-strip {
  margin-top: 16rpx;
  display: inline-block;
  background: linear-gradient(90deg, #ff8a3d 0%, #f5402a 100%);
  color: #fff; font-size: 24rpx; font-weight: 500; border-radius: 8rpx; padding: 8rpx 16rpx;
}
.pay-promo-list { margin-top: 16rpx; border-top: 2rpx dashed #f3c9bd; padding-top: 14rpx; }
.pay-promo-item { position: relative; font-size: 24rpx; color: #b3341f; line-height: 44rpx; padding-left: 24rpx; }
.pay-promo-item::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 18rpx;
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: #e60c0c;
}

.pay-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  background: #fafafa;
}
.pay-option-active { border-color: #F08718; background: #fff8ee; }
.pay-option-main { display: flex; align-items: center; }
.pay-option-logo { width: 56rpx; height: 56rpx; margin-right: 20rpx; flex-shrink: 0; border-radius: 8rpx; }
.pay-option-left { display: flex; flex-direction: column; }
.pay-option-name { font-size: 30rpx; color: #010101; font-weight: 500; }
.pay-option-tags { display: flex; align-items: center; margin-top: 10rpx; flex-wrap: wrap; }
.pay-option-tip { font-size: 24rpx; color: #e60c0c; margin-right: 12rpx; }
.pay-radio {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  border: 2rpx solid #ccc; box-sizing: border-box; flex-shrink: 0;
}
.pay-radio-active { border: 12rpx solid #F08718; background: #fff; }
.pay-sheet-btn {
  margin-top: 24rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: linear-gradient(180deg, rgba(253, 209, 0, 1) 0%, rgba(240, 135, 24, 1) 100%);
  color: #fff; font-size: 32rpx; border-radius: 20rpx;
}
