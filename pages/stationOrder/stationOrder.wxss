page { background: #f4f6f9; }
.page { padding: 16rpx 16rpx 140rpx; box-sizing: border-box; }

/* ===== 顶部站点纵览 ===== */
.sta-wrap {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 10rpx 20rpx;
  margin-bottom: 16rpx;
}
.sta-row { display: flex; }
.sta-col { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }

/* 站名：竖排，每列一字；固定高度使下方圆圈对齐 */
.sta-name {
  height: 232rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.25;
}
.sta-name.green { color: #1aad19; }
.sta-name.red { color: #e64340; }

/* 上/下/+ 圆标记 */
.sta-mark {
  width: 34rpx;
  height: 34rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  border: 2rpx solid #c8cdd4;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #98a0ab;
  background: #fff;
}
.sta-mark.up { border-color: #1aad19; color: #1aad19; }
.sta-mark.down { border-color: #e64340; color: #e64340; }

/* 虚线分隔 */
.sta-dash {
  border-top: 2rpx dashed #c8cdd4;
  margin: 20rpx 0;
}

/* 时间：竖排两行 */
.sta-time {
  font-size: 26rpx;
  color: #1a1a1a;
  line-height: 1.3;
  text-align: center;
}

/* ===== 通用卡片 ===== */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 16rpx;
}

/* 选择上/下车点、乘车人 */
.pick-row {
  display: flex;
  align-items: center;
  height: 96rpx;
}
.pick-row.center { justify-content: center; }
.pick-city {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  width: 160rpx;
  flex: none;
}
.pick-label {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.pick-label.picked { color: #2f7cf6; }
.pick-label.mid { flex: none; }
.pick-arrow {
  font-size: 34rpx;
  color: #2f7cf6;
  flex: none;
}
.line { border-top: 2rpx solid #f0f2f5; }

/* 乘车人头部 */
.psg-head {
  display: flex;
  align-items: center;
  padding: 20rpx 0 8rpx;
}
.psg-names { display: flex; align-items: center; gap: 16rpx; }
.psg-tag {
  position: relative;
  min-width: 76rpx;
  padding: 6rpx 18rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  border-radius: 8rpx;
  background: #f4f6f9;
}
.psg-tag.on {
  color: #2f7cf6;
  font-weight: 700;
  background: #e8f1fd;
  border: 2rpx solid #2f7cf6;
}
.psg-child {
  position: absolute;
  top: -14rpx;
  right: -10rpx;
  font-size: 18rpx;
  color: #fff;
  background: #ff8f1f;
  border-radius: 8rpx 8rpx 8rpx 0;
  padding: 0 8rpx;
  line-height: 26rpx;
}
.psg-add {
  margin-left: auto;
  font-size: 28rpx;
  color: #2f7cf6;
}
/* 多选选中角标（左上，儿童标在右上，互不冲突） */
.psg-tick {
  position: absolute;
  top: -14rpx;
  left: -10rpx;
  font-size: 18rpx;
  color: #fff;
  background: #2f7cf6;
  border-radius: 8rpx 0 8rpx 8rpx;
  padding: 0 8rpx;
  line-height: 26rpx;
}
.psg-none { padding: 8rpx 0 24rpx; font-size: 26rpx; color: #999; text-align: center; }

/* 乘车人明细行 */
.psg-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0 24rpx;
  font-size: 28rpx;
  color: #1a1a1a;
}
.psg-name { font-weight: 700; margin-right: 28rpx; }
.psg-type { color: #666; margin-right: 28rpx; }
.psg-phone { flex: 1; font-size: 26rpx; color: #333; }
.psg-price { font-weight: 700; }

/* ===== 优惠方式 ===== */
.coupon-row {
  display: flex;
  align-items: center;
  height: 100rpx;
  padding: 0 24rpx;
}
.coupon-label { font-size: 32rpx; font-weight: 700; color: #1a1a1a; }
.coupon-none {
  margin-left: auto;
  font-size: 28rpx;
  color: #98a0ab;
}

/* ===== 乘车须知 ===== */
.notice { padding: 24rpx; }
.notice-title { font-size: 26rpx; font-weight: 700; color: #1a1a1a; margin-bottom: 8rpx; }
.notice-h { font-size: 24rpx; font-weight: 700; color: #1a1a1a; margin-top: 14rpx; }
.notice-p {
  font-size: 22rpx;
  color: #8a94a2;
  line-height: 1.6;
  margin-top: 4rpx;
}
.notice-agree {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 20rpx;
}
.cb {
  width: 34rpx;
  height: 34rpx;
  border-radius: 6rpx;
  border: 2rpx solid #c8cdd4;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  margin-right: 10rpx;
}
.cb.on { background: #1aad19; border-color: #1aad19; }
.agree-txt { font-size: 28rpx; font-weight: 700; color: #1a1a1a; }

/* ===== 底部支付栏 ===== */
.paybar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  background: #fff;
  border-top: 2rpx solid #f0f2f5;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.pay-left { flex: 1; min-width: 0; }
.pay-amount { font-size: 28rpx; color: #1a1a1a; }
.pay-num { font-size: 34rpx; font-weight: 700; color: #e64340; }
.pay-detail {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #2f7cf6;
  margin-right: 20rpx;
}
.pay-tri { font-size: 20rpx; margin-left: 6rpx; transition: transform .2s; }
.pay-tri.up { transform: rotate(180deg); }
.pay-btn {
  flex: none;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 44rpx;
  border-radius: 12rpx;
  background: #2f7cf6;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

/* ===== 明细弹层 ===== */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .45);
  display: flex;
  align-items: flex-end;
  z-index: 10;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 30rpx 50rpx;
  box-sizing: border-box;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}
.sheet-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #666;
  padding: 14rpx 0;
}
.sheet-row.total { color: #1a1a1a; font-weight: 700; border-top: 2rpx solid #f0f2f5; }
