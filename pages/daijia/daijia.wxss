page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ---------- 棕色皮革 Banner ---------- */
.banner {
  position: relative;
  background: linear-gradient(135deg, #8B6914 0%, #6B4E10 100%);
  padding: 50rpx 40rpx 40rpx;
  border-radius: 0 0 24rpx 24rpx;
  display: flex;
  overflow: hidden;
}

/* 皮革纹理感：用多层径向渐变模拟 */
.banner::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 20% 30%, rgba(255,255,255,0.08) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(0,0,0,0.15) 0%, transparent 50%);
  pointer-events: none;
}

.banner-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  z-index: 2;
}

.banner-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 6rpx;
  margin-bottom: 16rpx;
}

.banner-sub {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.poem {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.poem-line {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.6;
}

.banner-right {
  display: flex;
  align-items: center;
  z-index: 2;
  margin-left: 20rpx;
}

.banner-emoji {
  font-size: 120rpx;
}

/* ---------- 副标题 ---------- */
.slogan {
  padding: 30rpx 40rpx 10rpx;
  font-size: 28rpx;
  color: #888;
}

/* ---------- 表单 ---------- */
.form-card {
  margin: 20rpx 32rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 10rpx 32rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 110rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 140rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  flex-shrink: 0;
}

.form-value {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.form-value.ph {
  color: #999;
  font-size: 28rpx;
}

.form-value.fee {
  font-weight: 600;
  color: #333;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  padding: 20rpx 0;
}

.ph {
  color: #999;
  font-size: 28rpx;
}

/* ---------- 提交按钮 ---------- */
.submit-btn {
  margin: 50rpx 32rpx 0;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #8B6914 0%, #6B4E10 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(107, 78, 16, 0.35);
}

.submit-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
}

/* ---------- 底部两个按钮 ---------- */
.bottom-actions {
  display: flex;
  gap: 24rpx;
  margin: 80rpx 32rpx 0;
}

.bottom-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.home-btn {
  background: linear-gradient(135deg, #8B6914 0%, #6B4E10 100%);
  color: #fff;
}

.order-btn {
  background: linear-gradient(135deg, #8B6914 0%, #6B4E10 100%);
  color: #fff;
}
