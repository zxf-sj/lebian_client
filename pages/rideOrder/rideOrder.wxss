page { background: #f4f6f9; }
.page { padding: 20rpx 24rpx 0; box-sizing: border-box; }

/* ===== 时间段条：顶部独立一条，点击弹框（与 ride 包车顶部一致） ===== */
.ch-timebar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eaf1fb;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
}
.ch-timebar:active { background: #dbe8fa; }
.ctb-label { font-size: 27rpx; color: #4a525c; margin-right: 16rpx; }
.ctb-val { display: flex; align-items: center; }
.ctb-time { font-size: 30rpx; font-weight: 700; color: #2ba9e8; }

/* ===== 行程条三胶囊（日期 / 线路 / 价格） ===== */
.ch-trip {
  display: flex;
  align-items: stretch;
  margin-bottom: 18rpx;
  gap: 16rpx;
}
.ch-chip {
  flex: 1;
  min-width: 0;
  background: #e8f1fd;
  border-radius: 16rpx;
  padding: 14rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ch-chip.wide { flex: 1.8; }
.ch-chip.tap:active { background: #dbe8fa; }
.chc-label { font-size: 28rpx; font-weight: 700; color: #1a1a1a; }
.chc-row { display: flex; align-items: center; margin-top: 4rpx; }
.chc-md { font-size: 26rpx; color: #4a525c; }
.chc-route { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.chc-arrow { font-size: 32rpx; color: #7b8593; margin-left: 6rpx; }

/* ===== 底部弹框：日期 / 时间段 ===== */
.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .45);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 30rpx 40rpx;
  box-sizing: border-box;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
  color: #1a1a1a;
}
.sheet-list { max-height: 560rpx; }
.sheet-item {
  display: flex;
  align-items: center;
  padding: 26rpx 10rpx;
  border-bottom: 2rpx solid #f0f2f5;
}
.sheet-item.on .si-label, .sheet-item.on .si-md { color: #2ba9e8; font-weight: 700; }
.si-label { font-size: 30rpx; color: #1a1a1a; }
.si-md { font-size: 28rpx; color: #6b7480; margin-left: 16rpx; }
.si-check { margin-left: auto; font-size: 30rpx; font-weight: 700; color: #2ba9e8; }
.sheet-tip { margin-top: 18rpx; font-size: 24rpx; color: #9aa3ad; text-align: center; }
.sheet-empty { padding: 50rpx 0; text-align: center; font-size: 28rpx; color: #9aa3ad; }

/* ===== 站点 ===== */
.sta-wrap {
  position: relative;
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
}
.sta-row { display: flex; align-items: center; padding: 30rpx 0; }
.sta-dot {
  width: 28rpx; height: 28rpx; border-radius: 50%; flex: none;
  display: flex; align-items: center; justify-content: center;
}
.sta-dot.on { background: #4cd964; }
.sta-dot.off { background: #e64340; }
.sta-dot-inner { width: 12rpx; height: 12rpx; border-radius: 50%; background: #fff; }

.sta-line {
  height: 2rpx;
  margin: 0 0 0 52rpx;
  background: #d0d5dd;
}
.sta-info { flex: 1; margin-left: 24rpx; display: flex; flex-direction: column; }
.sta-addr { font-size: 28rpx; color: #1a1a1a; font-weight: 500; }

/* ===== 车型卡 ===== */
.veh-card {
  position: relative;
  display: flex;
  align-items: center;
  background: #e8f1fd;
  border-radius: 20rpx;
  padding: 14rpx 16rpx 14rpx 24rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid transparent;
}
.veh-card.sel { background: #2ba9e8; border-color: #2ba9e8; box-shadow: 0 8rpx 20rpx rgba(43,169,232,.35); }
.veh-card.sel .veh-name, .veh-card.sel .veh-seats,
.veh-card.sel .veh-cl, .veh-card.sel .veh-origin { color: #fff; }

.car_left { width: 330rpx; flex: none; }
.car_top { display: flex; align-items: center; }
.veh-name { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.veh-price { margin-left: auto; margin-right: 10rpx; display: flex; flex-direction: column; align-items: center; }
.veh-cl { font-size: 24rpx; color: #6b7480; }
.veh-origin { font-size: 28rpx; font-weight: 700; color: #1a1a1a; margin-top: 2rpx; }

.veh-special { display: flex; align-items: baseline; justify-content: center; margin-top: 10rpx; }
.veh-hot {
  font-size: 26rpx; font-weight: 400; font-style: normal; color: #e64340;
  margin-right: 8rpx;
}
.veh-sp-price { font-size: 30rpx; font-weight: 700; color: #e64340; }

.veh-right { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: flex-end; }
.car_img {
  width: 100%;
  height: 170rpx;
}

/* ===== 成人/儿童 ===== */
.pax-row { display: flex; align-items: center; margin: 30rpx 0 10rpx;justify-content: center; }
.pax-group { display: flex; align-items: center; }
.pax-label { font-size: 32rpx; font-weight: 700; color: #1a1a1a; margin-right: 20rpx; }
.pax-divider { width: 2rpx; height: 48rpx; background: #c3cede; margin: 0 40rpx; }
.stepper { display: flex; align-items: center; }
.step-btn {
  width: 52rpx; height: 52rpx; border-radius: 10rpx;
  background: #2ba9e8; color: #fff;
  font-size: 34rpx; display: flex; align-items: center; justify-content: center;
}
.step-btn.dis { background: #b9c6d6; }
.step-btn.plus { background: #2ba9e8; }
.step-num { width: 66rpx; text-align: center; font-size: 32rpx; font-weight: 700; color: #1a1a1a; }

/* ===== 表单 ===== */
.form-row { display: flex; align-items: center; margin: 26rpx 0; }
.form-label { width: 170rpx; font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.form-input { flex: 1; background: #e8f1fd; border-radius: 14rpx; height: 76rpx; padding: 0 24rpx; font-size: 28rpx; }

.notice { margin: 10rpx 0 24rpx; }
.notice-line { display: block; font-size: 24rpx; color: #e64340; line-height: 40rpx; }

/* ===== 费用 ===== */
.fee-row { display: flex; align-items: center; padding: 12rpx 0; }
.fee-label { font-size: 28rpx; color: #1a1a1a; }
.fee-val { margin-left: auto; font-size: 28rpx; color: #1a1a1a; }
.fee-val.link { color: #2ba9e8; }

/* ===== 费用明细（参考 pingche2） ===== */
.details { box-sizing: border-box; padding: 0 20rpx; font-size: 24rpx; color: #999; }
.detailList {
  height: 60rpx;
  line-height: 60rpx;
  display: flex;
  padding: 0 10rpx;
  border-bottom: 2rpx solid #f0f2f5;
}
.detailList_l { height: 100%; width: 70%; text-align: left; font-size: 28rpx; color: #1a1a1a; }
.detailList_r { height: 100%; flex: 1; text-align: right; font-weight: 500; font-size: 28rpx; color: #1a1a1a; }
.additional { display: inline; color: #e64340; font-size: 24rpx; }

/* ===== 服务条款 ===== */
.signUp-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #999;
  height: 60rpx;
  line-height: 60rpx;
  width: 100%;
  margin: 26rpx 0 20rpx;
}
.signUp-tip-txt { height: 60rpx; margin-top: 20rpx; line-height: 60rpx; }
.signUp-tip-txt-protocol { font-size: 28rpx; color: #2ba9e8; }
.agree-box { width: 34rpx; height: 34rpx; border-radius: 6rpx; border: 2rpx solid #c3cede; display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: #fff; margin-right: 10rpx; flex: none; }
.agree-box.on { background: #2ba9e8; border-color: #2ba9e8; }

.pay-btn {
  height: 92rpx; line-height: 92rpx; text-align: center;
  border-radius: 46rpx;
  background: linear-gradient(90deg, #45c1f2, #1e9be0);
  color: #fff; font-size: 34rpx; font-weight: 600;
}
.pay-btn:active { opacity: .85; }
.gap { height: 40rpx; }
.CarSeatState {
  background-color: #999999;
}

/* ===== 用户须知弹框（参考 pingche2） ===== */
.mask-center {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .5);
  z-index: 999;
}
.box_3 {
  background: #fefefe;
  width: 80%;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 10%;
  border-radius: 20rpx;
  padding: 0 20rpx;
}
.buttonsView {
  width: 80%;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 85%;
  display: flex;
}
.buttons1 { width: 130rpx; font-size: 28rpx; background: #d09c0a; color: #fff; }
.buttons2 { width: 130rpx; font-size: 28rpx; background: #e60c0c; color: #fff; }

/* ===== 底部支付方式弹框（参考 pingche2） ===== */
.pay-mask {
  position: fixed;
  left: 0; top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}
.pay-sheet {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.pay-sheet-head { display: flex; align-items: center; justify-content: center; position: relative; }
.pay-sheet-title { font-size: 34rpx; font-weight: 600; color: #010101; }
.pay-sheet-close {
  position: absolute;
  right: 0;
  top: -10rpx;
  font-size: 48rpx;
  line-height: 48rpx;
  color: #999;
  padding: 0 10rpx;
}
.pay-sheet-phone {
  margin-top: 16rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #F08718;
  letter-spacing: 2rpx;
}
.pay-sheet-label { margin: 32rpx 0 16rpx; font-size: 28rpx; color: #666; }

/* 支付立减优惠卡片 */
.pay-promo { margin-top: 24rpx; background: #fdf0ec; border-radius: 16rpx; padding: 20rpx 20rpx 22rpx; }
.pay-promo-head { display: flex; align-items: center; }
.pay-promo-icon {
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  background: linear-gradient(135deg, #ff7a45 0%, #e60c0c 100%);
  color: #fff; font-size: 26rpx; font-weight: 600; border-radius: 10rpx; flex-shrink: 0;
}
.pay-promo-title { margin-left: 12rpx; font-size: 28rpx; font-weight: 600; color: #e60c0c; }
.pay-promo-detail { margin-left: auto; display: flex; align-items: center; font-size: 26rpx; color: #e60c0c; padding: 6rpx 0 6rpx 20rpx; }
.pay-promo-arrow { margin-left: 6rpx; font-size: 24rpx; transition: transform 0.2s; }
.pay-promo-arrow-up { transform: rotate(180deg); }
.pay-promo-strip {
  margin-top: 16rpx;
  display: inline-block;
  background: linear-gradient(90deg, #ff8a3d 0%, #f5402a 100%);
  color: #fff; font-size: 24rpx; font-weight: 500; border-radius: 8rpx; padding: 8rpx 16rpx;
}
.pay-promo-list { margin-top: 16rpx; border-top: 2rpx dashed #f3c9bd; padding-top: 14rpx; }
.pay-promo-item { position: relative; font-size: 24rpx; color: #b3341f; line-height: 44rpx; padding-left: 24rpx; }
.pay-promo-item::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 18rpx;
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: #e60c0c;
}

/* 支付方式选项 */
.pay-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  background: #fafafa;
}
.pay-option-active { border-color: #F08718; background: #fff8ee; }
.pay-option-main { display: flex; align-items: center; }
.pay-option-logo { width: 56rpx; height: 56rpx; margin-right: 20rpx; flex-shrink: 0; border-radius: 8rpx; }
.pay-option-left { display: flex; flex-direction: column; }
.pay-option-name { font-size: 30rpx; color: #010101; font-weight: 500; }
.pay-option-tags { display: flex; align-items: center; margin-top: 10rpx; flex-wrap: wrap; }
.pay-option-tip { font-size: 24rpx; color: #e60c0c; margin-right: 12rpx; }
.pay-option-tag {
  font-size: 22rpx; color: #fff;
  background: linear-gradient(90deg, #ff6a3d 0%, #e60c0c 100%);
  border-radius: 6rpx; padding: 2rpx 12rpx;
}
.pay-radio {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  border: 2rpx solid #ccc; box-sizing: border-box; flex-shrink: 0;
}
.pay-radio-active { border: 12rpx solid #F08718; background: #fff; }
.pay-sheet-btn {
  margin-top: 24rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: linear-gradient(180deg, rgba(253, 209, 0, 1) 0%, rgba(240, 135, 24, 1) 100%);
  color: #fff; font-size: 32rpx; border-radius: 20rpx;
}
