page { background: #f4f6f9; }
.page { padding: 20rpx 24rpx 0; box-sizing: border-box; }

/* ===== 行程条 ===== */
.ch-trip { display: flex; align-items: center; margin-bottom: 18rpx; }
.ch-chip {
  background: #e8f1fd;
  border-radius: 16rpx;
  padding: 12rpx 18rpx;
  margin-right: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
}
.ch-chip.wide { flex: 1; }
.chc-label { font-size: 26rpx; color: #1a1a1a; }
.chc-md { font-size: 24rpx; color: #6b7480; }
.chc-route { font-size: 28rpx; font-weight: 700; color: #1a1a1a; }
.chc-time { font-size: 24rpx; color: #6b7480; }
.chc-price { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }

/* ===== 站点 ===== */
.sta-wrap {
  position: relative;
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05);
}
.sta-row { display: flex; align-items: center; }
.sta-dot {
  width: 28rpx; height: 28rpx; border-radius: 50%; flex: none;
  display: flex; align-items: center; justify-content: center;
}
.sta-dot.on { background: #4cd964; }
.sta-dot.off { background: #e64340; }
.sta-dot-inner { width: 12rpx; height: 12rpx; border-radius: 50%; background: #fff; }

.sta-line {
  position: absolute; left: 45rpx; top: 50%;
  width: 2rpx; height: 40rpx; background: #d0d5dd;
  transform: translateY(-50%);
}
.sta-swap {
  position: absolute; left: 35rpx; top: 50%;
  transform: translateY(-50%);
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: #fff; border: 2rpx solid #d0d5dd;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: #6b7480; z-index: 2;
}
.sta-info { flex: 1; margin-left: 24rpx; display: flex; flex-direction: column; }
.sta-label { font-size: 24rpx; color: #6b7480; margin-bottom: 4rpx; }
.sta-addr { font-size: 28rpx; color: #1a1a1a; font-weight: 500; }

/* ===== 乘车人 ===== */
.pass-tabs { display: flex; margin-bottom: 20rpx; }
.pass-tab {
  background: #e8f1fd; border-radius: 24rpx; padding: 8rpx 32rpx;
  margin-right: 16rpx; border: 2rpx solid transparent;
}
.pass-tab.sel { background: #2ba9e8; border-color: #2ba9e8; }
.pass-tab-name { font-size: 28rpx; color: #1a1a1a; }
.pass-tab.sel .pass-tab-name { color: #fff; }

.pax-id-row {
  display: flex; align-items: center; margin-bottom: 20rpx;
  background: #f6f8fb; border-radius: 14rpx; padding: 16rpx 24rpx;
}
.pax-id-name { font-size: 28rpx; font-weight: 700; color: #1a1a1a; margin-right: 20rpx; }
.pax-id-num { font-size: 26rpx; color: #6b7480; }

/* ===== 车型卡 ===== */
.veh-card {
  position: relative;
  display: flex;
  align-items: center;
  background: #e8f1fd;
  border-radius: 20rpx;
  padding: 14rpx 16rpx 14rpx 24rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid transparent;
}
.veh-card.sel { background: #2ba9e8; border-color: #2ba9e8; box-shadow: 0 8rpx 20rpx rgba(43,169,232,.35); }
.veh-card.sel .veh-name, .veh-card.sel .veh-seats,
.veh-card.sel .veh-cl, .veh-card.sel .veh-origin { color: #fff; }

.car_left { width: 330rpx; flex: none; }
.car_top { display: flex; align-items: center; }
.veh-name { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.veh-price { margin-left: auto; margin-right: 10rpx; display: flex; flex-direction: column; align-items: center; }
.veh-cl { font-size: 24rpx; color: #6b7480; }
.veh-origin { font-size: 28rpx; font-weight: 700; color: #1a1a1a; margin-top: 2rpx; }

.veh-special { display: flex; align-items: baseline; justify-content: center; margin-top: 10rpx; }
.veh-hot {
  font-size: 26rpx; font-weight: 400; font-style: normal; color: #e64340;
  margin-right: 8rpx;
}
.veh-sp-price { font-size: 30rpx; font-weight: 700; color: #e64340; }

.veh-right { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: flex-end; }
.car_img {
  width: 100%;
  height: 170rpx;
}
.veh-tag {
  position: absolute; top: 8rpx; right: 12rpx;
  background: #fff; border-radius: 22rpx; padding: 2rpx 16rpx;
  font-size: 22rpx; color: #6b7480; line-height: 34rpx;
}
.veh-card.sel .veh-tag { color: #2ba9e8; }

/* ===== 成人/儿童 ===== */
.pax-row { display: flex; align-items: center; margin: 30rpx 0 10rpx;justify-content: center; }
.pax-group { display: flex; align-items: center; }
.pax-label { font-size: 32rpx; font-weight: 700; color: #1a1a1a; margin-right: 20rpx; }
.pax-divider { width: 2rpx; height: 48rpx; background: #c3cede; margin: 0 40rpx; }
.stepper { display: flex; align-items: center; }
.step-btn {
  width: 52rpx; height: 52rpx; border-radius: 10rpx;
  background: #2ba9e8; color: #fff;
  font-size: 34rpx; display: flex; align-items: center; justify-content: center;
}
.step-btn.dis { background: #b9c6d6; }
.step-btn.plus { background: #2ba9e8; }
.step-num { width: 66rpx; text-align: center; font-size: 32rpx; font-weight: 700; color: #1a1a1a; }

/* ===== 表单 ===== */
.form-row { display: flex; align-items: center; margin: 26rpx 0; }
.form-label { width: 170rpx; font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.form-input { flex: 1; background: #e8f1fd; border-radius: 14rpx; height: 76rpx; padding: 0 24rpx; font-size: 28rpx; }

.notice { margin: 10rpx 0 24rpx; }
.notice-line { display: block; font-size: 24rpx; color: #e64340; line-height: 40rpx; }

/* ===== 费用 ===== */
.fee-row { display: flex; align-items: center; padding: 12rpx 0; }
.fee-label { font-size: 28rpx; color: #1a1a1a; }
.fee-val { margin-left: auto; font-size: 28rpx; color: #1a1a1a; }
.fee-val.link { color: #2ba9e8; }
.fee-val.price { color: #1a1a1a; font-weight: 700; }
.fee-val.price.big { font-size: 32rpx; }
.fee-row.total .fee-label { font-weight: 700; font-size: 32rpx; }

.agree { display: flex; align-items: center; justify-content: center; margin: 26rpx 0 20rpx; }
.agree-box { width: 34rpx; height: 34rpx; border-radius: 6rpx; border: 2rpx solid #c3cede; display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: #fff; margin-right: 10rpx; }
.agree-box.on { background: #2ba9e8; border-color: #2ba9e8; }
.agree-text { font-size: 26rpx; color: #1a1a1a; }
.agree-link { font-size: 26rpx; color: #2ba9e8; font-weight: 700; }

.pay-btn {
  height: 92rpx; line-height: 92rpx; text-align: center;
  border-radius: 46rpx;
  background: linear-gradient(90deg, #45c1f2, #1e9be0);
  color: #fff; font-size: 34rpx; font-weight: 600;
}
.pay-btn:active { opacity: .85; }
.gap { height: 40rpx; }
