/* 陪诊首页 - 匹配设计稿蓝青风格 */
page {
  background-color: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

.container {
  padding-bottom: 40rpx;
  min-height: 100vh;
}

/* --- 顶部 Banner：蓝青渐变 --- */
.banner-section {
  position: relative;
  height: 380rpx;
  background: linear-gradient(135deg, #5DE8E0 0%, #1B6FE0 100%);
  overflow: hidden;
  padding: 50rpx 40rpx 30rpx;
  box-sizing: border-box;
  border-radius: 0 0 24rpx 24rpx;
}

.banner-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
}

.main-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}

.sub-title {
  font-size: 26rpx;
  color: #1a1a1a;
  margin-bottom: 36rpx;
  letter-spacing: 2rpx;
  font-weight: 500;
}

.service-tags {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.tag-item {
  font-weight: 600;
}

.divider {
  width: 2rpx;
  height: 26rpx;
  background-color: #1a1a1a;
  margin: 0 16rpx;
  opacity: 0.7;
}

/* --- 通知栏 --- */
.notice-bar {
  display: flex;
  align-items: center;
  background-color: #fff8e6;
  padding: 0 24rpx;
  height: 72rpx;
  border-radius: 12rpx;
  margin: 24rpx;
}

.notice-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-swiper {
  flex: 1;
  height: 72rpx;
}

.notice-item {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  color: #ff9900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* --- 金刚区 Grid --- */
.grid-menu {
  padding: 0 24rpx;
}

.grid-row {
  display: flex;
  height: 340rpx;
  margin-bottom: 24rpx;
}

.card {
  border-radius: 20rpx;
  padding: 36rpx;
  box-sizing: border-box;
  position: relative;
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  overflow: hidden;
}

/* 左侧大卡片：蓝青渐变 */
.card-large {
  flex: 1.8;
  margin-right: 20rpx;
  background: linear-gradient(160deg, #5BE0E0 0%, #2B7CE9 100%);
  box-shadow: 0 8rpx 24rpx rgba(43, 124, 233, 0.25);
}

/* 右侧列容器 */
.grid-col-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 辅助就医：粉红到浅绿渐变 */
.card-small.green-gradient {
  height: 160rpx;
  background: linear-gradient(135deg, #FF8A8A 0%, #8AE6B5 100%);
  box-shadow: 0 6rpx 18rpx rgba(255, 138, 138, 0.2);
}

/* 诊前咨询：橙黄渐变 */
.card-small.orange-gradient {
  height: 160rpx;
  background: linear-gradient(135deg, #FFC94D 0%, #FF8A65 100%);
  box-shadow: 0 6rpx 18rpx rgba(255, 160, 77, 0.2);
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 24rpx;
  opacity: 0.95;
  white-space: pre-line;
  line-height: 1.6;
}

.card-desc-sm {
  font-size: 22rpx;
  opacity: 0.95;
  margin-top: 8rpx;
}

.card-icon-placeholder {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 80rpx;
  opacity: 0.25;
}
.card-icon-placeholder.small {
  font-size: 52rpx;
}

/* --- 下方列表：2列3行 --- */
.grid-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.list-item {
  width: 48.5%;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.list-info {
  display: flex;
  flex-direction: column;
}

.list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}

.list-desc {
  font-size: 22rpx;
  color: #999;
}

.list-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
