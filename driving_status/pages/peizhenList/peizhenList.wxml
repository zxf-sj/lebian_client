<view class="container">

  <!-- 顶部 Banner 区域 -->
  <view class="banner-section">
    <view class="banner-content">
      <text class="main-title">陪诊</text>
      <text class="sub-title">乐遍出行 健康无忧</text>

      <!-- 服务标签栏 -->
      <view class="service-tags">
        <text class="tag-item">陪同就医</text>
        <view class="divider"></view>
        <text class="tag-item">代替问诊</text>
        <view class="divider"></view>
        <text class="tag-item">代买药</text>
        <view class="divider"></view>
        <text class="tag-item">取结果</text>
      </view>
      <view class="service-tags">
        <text class="tag-item">手续办理</text>
        <view class="divider"></view>
        <text class="tag-item">人工排队</text>
        <view class="divider"></view>
        <text class="tag-item">约检查</text>
      </view>
    </view>
  </view>

  <!-- 通知栏 -->
  <view class="notice-bar">
    <view class="notice-icon">📢</view>
    <swiper
      class="notice-swiper"
      vertical="{{true}}"
      autoplay="{{true}}"
      circular="{{true}}"
      interval="{{3000}}"
      duration="{{500}}"
    >
      <block wx:for="{{noticeList}}" wx:key="index">
        <swiper-item>
          <view class="notice-item">{{item}}</view>
        </swiper-item>
      </block>
    </swiper>
  </view>

  <!-- 金刚区：左侧大卡片 + 右侧两个小卡片 -->
  <view class="grid-menu">
    <view class="grid-row">
      <view class="card card-large" bindtap="onServiceTap" data-type="就医陪诊">
        <view class="card-text">
          <text class="card-title">就医陪诊</text>
          <text class="card-desc">专业服务
全程照护</text>
        </view>
        <view class="card-icon-placeholder">🏥</view>
      </view>
      <view class="grid-col-right">
        <view class="card card-small green-gradient" bindtap="onServiceTap" data-type="辅助就医">
          <view class="card-text">
            <text class="card-title">辅助就医</text>
            <text class="card-desc-sm">就医规划 精准就医</text>
          </view>
          <view class="card-icon-placeholder small">❤️</view>
        </view>
        <view class="card card-small orange-gradient" bindtap="onServiceTap" data-type="诊前咨询">
          <view class="card-text">
            <text class="card-title">诊前咨询</text>
            <text class="card-desc-sm">一键对接 安心寻医</text>
          </view>
          <view class="card-icon-placeholder small">👂</view>
        </view>
      </view>
    </view>

    <!-- 下方 2 列列表 -->
    <view class="grid-list">
      <view class="list-item" bindtap="onServiceTap" data-type="代办问诊">
        <view class="list-info">
          <text class="list-title">代办问诊</text>
          <text class="list-desc">省心 省时 省钱</text>
        </view>
        <view class="list-icon">🩺</view>
      </view>
      <view class="list-item" bindtap="onServiceTap" data-type="代办买药">
        <view class="list-info">
          <text class="list-title">代办买药</text>
          <text class="list-desc">便捷高效 省时省力</text>
        </view>
        <view class="list-icon">💊</view>
      </view>
      <view class="list-item" bindtap="onServiceTap" data-type="送/取服务">
        <view class="list-info">
          <text class="list-title">送/取服务</text>
          <text class="list-desc">便捷高效 省时省力</text>
        </view>
        <view class="list-icon">📃</view>
      </view>
      <view class="list-item" bindtap="onServiceTap" data-type="检查预约">
        <view class="list-info">
          <text class="list-title">检查预约</text>
          <text class="list-desc">预约代办 高效便捷</text>
        </view>
        <view class="list-icon">📋</view>
      </view>
      <view class="list-item" bindtap="onServiceTap" data-type="院内服务">
        <view class="list-info">
          <text class="list-title">院内服务</text>
          <text class="list-desc">出入院办理 院内探望</text>
        </view>
        <view class="list-icon">♿</view>
      </view>
      <view class="list-item" bindtap="onServiceTap" data-type="会员套餐">
        <view class="list-info">
          <text class="list-title">会员套餐</text>
          <text class="list-desc">就医无忧 高端之选</text>
        </view>
        <view class="list-icon">💼</view>
      </view>
    </view>
  </view>

</view>
<kefu-float />
