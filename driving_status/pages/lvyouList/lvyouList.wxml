<view class="map_container">
  <view class="lunbo">
    <swiper indicator-dots="{{indicatorDots}}" autoplay="{{autoplay}}" interval="{{interval}}" duration="{{duration}}" class="swipers">
      <block wx:for="{{lunBoImg}}" wx:key="index">
        <swiper-item>
          <image src="{{imgUrl+item.ShowPicUrl}}" mode="widthFix" class="lunimg" />
        </swiper-item>
      </block>
    </swiper>
  </view>
  <view class="warn">
    <image src="/assets/images/laba2.png" style="width:40rpx;height:40rpx"></image>
    <view class='marquee' style='width:{{marqueeWidth}}rpx;'>
      <view class='marqueeTitle' style="width:{{length}}rpx;margin-left:{{marqueeMargin}}px;transform:translateX( {{marqueeDistance}}rpx);font-size: {{size}}rpx;">{{title}}</view>
    </view>
  </view>
  <!-- 这是九宫格 -->
  <view class="titleView">
    <image mode="aspectFit" src="/assets/images/letonglogo.png" />
  </view>
  <!-- pages/index/index.wxml -->
  <view class="container">
    <!-- 顶部 Tab 切换 -->
    <view class="tab-bar">
      <block wx:for="{{tabs}}" wx:key="index">
        <view class="tab-item {{activeTab === index ? 'active' : ''}}" bindtap="switchTab" data-index="{{index}}">
          {{item}}
          <!-- 底部激活线条 -->
          <view class="line" wx:if="{{activeTab === index}}"></view>
        </view>
      </block>
    </view>

    <!-- 滚动内容区域 -->
    <scroll-view scroll-y class="main-content">

      <!-- 旅游包车表单 (Tab 1) -->
      <view wx:if="{{activeTab === 0 || activeTab === 2}}">

        <!-- 基础信息输入 -->
        <view class="form-group">
          <view class="input-item" bind:tap="startingPoint" ><text class="label">起点</text>{{starting_point?starting_point:'请选择起点'}}</view>
          <view class="input-item" bind:tap="endting_point"><text class="label">终点</text>{{endting_point?endting_point:'请选择终点'}}</view>
          <view class="input-item"><text class="label">电话</text><input bindinput="searchInputend" type="number" value="{{lvyouTel}}" placeholder="请输入联系电话" maxlength="11" /></view>
          <view class="phoneError" wx:if="{{lvyouTel_phoneError != ''}}" >{{lvyouTel_phoneError}}</view>
          <view class="input-item"><text class="label">出发日期</text>
            <!-- start="2026-01-01" end="2017-09-01"  -->
            <picker  range="{{timeArr}}" range-key="RunTime" bindchange="lvyou_bindDateChange">
              <view class="picker">
                {{lvyou_date}}
              </view>
            </picker>
          </view>
        </view>

        <!-- 车型选择标题 -->
        <view class="section-title">车型选择</view>

        <!-- 车型列表 (横向滚动) -->
        <scroll-view scroll-x class="car-list" show-scrollbar="false">
          <block wx:for="{{carList}}" wx:key="id">
            <view class="car-card {{selectedCarId === item.Id ? 'car_active' : ''}}" bindtap="selectCar" data-id="{{item.Id}}">
              <image src="{{baseUrl + item.Note}}" mode="aspectFill"></image>
              <view class="car-info">
                <text class="car-name">{{item.CarType_Name}}</text>
                <text class="car-seat">👤 {{item.SeatNumber}}座</text>
                <view class="price-box">
                  <!-- <text class="original-price">¥{{item.originPrice}}</text> -->
                  <text class="current-price">¥{{roundTrip?item.Price:item.OriginalPrice}}/公里</text>
                </view>
              </view>
            </view>
          </block>
        </scroll-view>

        <!-- 单程/往返 单选框 -->
        <view class="section-title">行程类型</view>
        <radio-group class="radio-group" bindchange="radioChange">
          <label class="radio-item" wx:for="{{tripTypes}}" wx:key="value">
            <radio value="{{item.value}}" checked="{{item.checked}}" color="#007AFF" /> {{item.name}}
          </label>
        </radio-group>

        <!-- 底部按钮 (模拟) -->
        <view class="submit-btn" bind:tap="submit">立即预订</view>
      </view>

      <!-- 其他 Tab 占位 -->
      <view wx:elif="{{activeTab === 1}}">
        <view class="placeholder" style="margin-top: 0;">
          <!-- 顶部 Tab 切换 -->
          <view class="tab-bar">
            <block wx:for="{{tabs2}}" wx:key="index">
              <view class="tab-item {{activeTab2 === index ? 'active' : ''}}" bindtap="switchTab2" data-index="{{index}}">
                {{item}}
                <!-- 底部激活线条 -->
                <view class="line" wx:if="{{activeTab2 === index}}"></view>
              </view>
            </block>
          </view>
          <view wx:if="{{activeTab2 === 0 || activeTab2 === 1 }}">
            <view class="placeholder" style="margin-top: 0;">
              <!-- 车型选择标题 -->
              <view class="section-title" style="text-align: left;">车型选择</view>

              <!-- 车型列表 (横向滚动) -->
              <scroll-view scroll-x class="car-list" show-scrollbar="false">
                <block wx:for="{{carList}}" wx:key="id">
                  <view class="car-card {{selectedCarId === item.id ? 'active' : ''}}" bindtap="selectCar" data-id="{{item.id}}">
                    <image src="{{item.image}}" mode="aspectFill"></image>
                    <view class="car-info">
                      <text class="car-name">{{item.name}}</text>
                      <text class="car-seat">👤 {{item.seat}}座</text>
                      <view class="price-box">
                        <text class="original-price">¥{{item.originPrice}}</text>
                        <text class="current-price">¥{{item.price}}</text>
                      </view>
                    </view>
                  </view>
                </block>
              </scroll-view>
              <!-- 旅游包车表单 (Tab 1) -->
              <view wx:if="{{activeTab2 === 0 || activeTab2 === 1}}">

                <!-- 基础信息输入 -->
                <view class="form-group">
                  <view class="input-item"><text class="label">车型选择</text><input placeholder="请输入起点" /></view>
                  <view class="input-item"><text class="label">使用时间段</text><input placeholder="请输入终点" /></view>
                  <view class="input-item"><text class="label">押金及价格</text><input placeholder="请输入联系电话" /></view>
                  <view class="input-item"><text class="label">备注</text><input placeholder="请选择日期" disabled="true" bindtap="showDatePicker" /></view>
                </view>
                <!-- 底部按钮 (模拟) -->
                <view class="submit-btn">立即预订</view>
              </view>
            </view>
          </view>
          <view wx:if="{{activeTab2 === 1 }}">
            <view class="placeholder">这里是【悦驾易租】的内容</view>
          </view>
          <view wx:if="{{activeTab2 === 2 }}">
            <view class="placeholder"  style="margin-top: 0;">
              <view wx:if="{{activeTab2 === 2}}">

                <!-- 基础信息输入 -->
                <view class="form-group">
                  <view class="input-item"><text class="label">电话</text><input placeholder="请输入起点" /></view>
                  <view class="input-item"><text class="label">方向</text><input placeholder="请输入终点" /></view>
                  <view class="input-item"><text class="label">位置</text><input placeholder="请输入联系电话" /></view>
                  <view class="input-item"><text class="label">备注</text><input placeholder="请选择日期" disabled="true" bindtap="showDatePicker" /></view>
                </view>
                <!-- 底部按钮 (模拟) -->
                <view class="submit-btn">立即预订</view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view wx:else>
        <view class="placeholder">这里是【协议客户】的内容</view>
      </view>

    </scroll-view>
  </view>
</view>