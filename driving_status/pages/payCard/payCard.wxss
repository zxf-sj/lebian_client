/* driving_status/pages/payCard/payCard.wxss */
@import "../../../miniprogram_npm//weui-miniprogram//weui-wxss/dist/style/weui.wxss";
.page {
  width: 100%;
  height: 100vh;
  background-color: #f6f6f6;
}

.box {
  width: 100%;
}

.nav {
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  height: 100rpx;
  display: flex;
  margin-top: 10rpx;
  background-color: #fff;
}
.nav text {
  width: 200rpx;
}
.list {
  width: 95%;
  box-sizing: border-box;
  position: relative;
  margin: 0 auto;
}

.list image {
  width: 100%;
  height: 200rpx;
}

.item {
  width: 98%;
  height: 200rpx;
  position: absolute;
  left: 4rpx;
  top: 0;
  display: flex;
  box-sizing: border-box;
  border-radius: 30rpx;
  overflow: hidden;
}
.item image {
  width: 28%;
}
.item_l {
  width: 28%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  position: absolute;
}
.kong {
  height: 100rpx;
  font-size: 24rpx;
  color: #fff;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: flex-end;
}
.five {
  height: 100rpx;
  color: #fff;
  font-size: 60rpx;
  text-align: center;
  line-height: 90rpx; 
  font-weight: 900;
  box-sizing: border-box;
}
.remaining {
  height: 50rpx;
  box-sizing: border-box;
  line-height: 50rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
}
.tag{
  width: 120rpx;
  height: 120rpx;
  position: absolute;
  right: 0;
  top: 0;
  color: #000;
}

.tag image{
  width: 120rpx;
  height: 120rpx;
}

.num{
  font-size: 24rpx;
  position: absolute;
  right: 6rpx;
  top: 25rpx;
  transform: rotate(45deg);
}

.item_l text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 100;
}

.item_r {
  width: 72%;
  display: flex;
  flex-direction: column;
}

.item_r_t {
  flex: 1;
  box-sizing: border-box;
  line-height: 100rpx;
  padding-left: 60rpx;
  /* color: #fff; */
}

.item_r_b {
  flex: 1;
  box-sizing: border-box;
  line-height: 100rpx;
  padding-left: 60rpx;
}
.item_main {
  width: 120rpx;
  text-align: center;
  border-radius: 10rpx;
  height: 60rpx;
  line-height: 60rpx;
  /* color: #fff; */
}
.pay {
  position: absolute;
  bottom: 30rpx;
  right: 30rpx;
  background: linear-gradient(135deg, #FF6B81 0%, #FF4757 100%);
    transition: transform 0.2s ease, opacity 0.2s ease;
  width: 180rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  color: #fff;
  border-radius: 9999px;
}

.main {
  width: 100%;
  box-sizing: border-box;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #010101;
}
.txt {
  color: #f23d3d;
}
.imgBox {
 padding: 10rpx;
 width: 100%;
 box-sizing: border-box;
}
.imgBox image {
  width: 100%;
}

/* ===== 底部支付方式弹框 ===== */
.pay-mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.pay-sheet {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.pay-sheet-head {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.pay-sheet-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #010101;
}

.pay-sheet-close {
  position: absolute;
  right: 0;
  top: -10rpx;
  font-size: 48rpx;
  line-height: 48rpx;
  color: #999;
  padding: 0 10rpx;
}

.pay-sheet-phone {
  margin-top: 16rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #F08718;
  letter-spacing: 2rpx;
}

.pay-sheet-label {
  margin: 32rpx 0 16rpx;
  font-size: 28rpx;
  color: #666;
}

/* ===== 支付立减优惠卡片 ===== */
.pay-promo {
  margin-top: 24rpx;
  background: #fdf0ec;
  border-radius: 16rpx;
  padding: 20rpx 20rpx 22rpx;
}

.pay-promo-head {
  display: flex;
  align-items: center;
}

.pay-promo-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: linear-gradient(135deg, #ff7a45 0%, #e60c0c 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.pay-promo-title {
  margin-left: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #e60c0c;
}

.pay-promo-detail {
  margin-left: auto;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #e60c0c;
  padding: 6rpx 0 6rpx 20rpx;
}

.pay-promo-arrow {
  margin-left: 6rpx;
  font-size: 24rpx;
  transition: transform 0.2s;
}

.pay-promo-arrow-up {
  transform: rotate(180deg);
}

.pay-promo-strip {
  margin-top: 16rpx;
  display: inline-block;
  background: linear-gradient(90deg, #ff8a3d 0%, #f5402a 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.pay-promo-list {
  margin-top: 16rpx;
  border-top: 2rpx dashed #f3c9bd;
  padding-top: 14rpx;
}

.pay-promo-item {
  position: relative;
  font-size: 24rpx;
  color: #b3341f;
  line-height: 44rpx;
  padding-left: 24rpx;
}

.pay-promo-item::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 18rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #e60c0c;
}

.pay-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  background: #fafafa;
}

.pay-option-active {
  border-color: #F08718;
  background: #fff8ee;
}

.pay-option-main {
  display: flex;
  align-items: center;
}

.pay-option-logo {
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
}

.pay-option-left {
  display: flex;
  flex-direction: column;
}

.pay-option-name {
  font-size: 30rpx;
  color: #010101;
  font-weight: 500;
}

.pay-option-tags {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.pay-option-tip {
  font-size: 24rpx;
  color: #e60c0c;
  margin-right: 12rpx;
}

.pay-option-tag {
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(90deg, #ff6a3d 0%, #e60c0c 100%);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.pay-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  box-sizing: border-box;
  flex-shrink: 0;
}

.pay-radio-active {
  border: 12rpx solid #F08718;
  background: #fff;
}

.pay-sheet-btn {
  margin-top: 24rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: linear-gradient(180deg, rgba(253, 209, 0, 1) 0%, rgba(240, 135, 24, 1) 100%);
  color: #fff;
  font-size: 32rpx;
  border-radius: 20rpx;
}