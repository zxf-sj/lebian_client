.tabbar-placeholder {
  width: 100%;
  height: calc(124rpx + env(safe-area-inset-bottom));
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 998;
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #eef4fb;
  box-sizing: border-box;
}

.tab-item {
  margin-right: 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 36rpx;
  border-radius: 38rpx;
  background: #dde7f3;
  color: #333333;
  font-size: 30rpx;
  text-align: center;
  box-sizing: border-box;
  flex: 1;
}

.tab-item:last-child {
  margin-right: 0;
}

.tab-item.active {
  background: linear-gradient(90deg, #45c1f2, #1e9be0);
  color: #1f2d3d;
  font-weight: 500;
  color: #fff;
}
